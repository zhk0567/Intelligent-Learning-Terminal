.section {
  margin-top: 32rpx;
}

.section-framed {
  border-radius: 28rpx;
  border: 1rpx solid rgba(165, 124, 44, 0.4);
  background: var(--bg-card);
  padding: 28rpx;
}

.section-head {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  gap: 16rpx;
  margin-bottom: 24rpx;
}

.section-head-left {
  display: flex;
  align-items: center;
  min-width: 0;
  flex: 1 1 0%;
}

.section-bar {
  display: inline-block;
  width: 6rpx;
  height: 32rpx;
  border-radius: 3rpx;
  background: var(--ancient-cinnabar);
  margin-right: 16rpx;
  flex-shrink: 0;
}

.section-titles {
  min-width: 0;
}

.section-title {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--text-primary);
  line-height: 1.2;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.section-eyebrow {
  font-size: 20rpx;
  color: rgba(165, 124, 44, 0.85);
  letter-spacing: 0.18em;
  text-transform: uppercase;
  margin-top: 4rpx;
}

.section-action {
  flex-shrink: 0;
  display: inline-flex;
  align-items: center;
}
