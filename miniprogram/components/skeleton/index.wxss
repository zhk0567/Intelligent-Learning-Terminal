.skeleton {
  display: block;
  background: rgba(165, 124, 44, 0.18);
  border: 1rpx solid rgba(165, 124, 44, 0.18);
  animation: pulseSoft 1.4s ease-in-out infinite;
}

.skeleton.bar {
  height: 32rpx;
  border-radius: 12rpx;
}
.skeleton.line {
  height: 24rpx;
  border-radius: 8rpx;
}
.skeleton.square {
  aspect-ratio: 1 / 1;
  border-radius: 22rpx;
  width: 100%;
}
.skeleton.circle {
  border-radius: 9999rpx;
}

@keyframes pulseSoft {
  0% { opacity: 0.7; }
  50% { opacity: 0.35; }
  100% { opacity: 0.7; }
}
