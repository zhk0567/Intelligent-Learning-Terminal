.cover {
  position: relative;
  display: block;
  overflow: hidden;
  border: 1rpx solid rgba(165, 124, 44, 0.4);
  min-width: 0;
  box-sizing: border-box;
}

/* ::before 的 padding 百分比相对本组件宽度，避免父级 width% 时自高算错；同时兼容无 aspect-ratio 的环境 */
.cover-aspect-square::before,
.cover-aspect-16-9::before,
.cover-aspect-16-7::before,
.cover-aspect-2-1::before,
.cover-aspect-3-2::before,
.cover-aspect-4-3::before {
  content: "";
  display: block;
  width: 100%;
}
.cover-aspect-square::before {
  padding-bottom: 100%;
}
.cover-aspect-16-9::before {
  padding-bottom: 56.25%;
}
.cover-aspect-16-7::before {
  padding-bottom: 43.75%;
}
.cover-aspect-2-1::before {
  padding-bottom: 50%;
}
.cover-aspect-3-2::before {
  padding-bottom: 66.666%;
}
.cover-aspect-4-3::before {
  padding-bottom: 75%;
}

.cover-rounded-md  { border-radius: 12rpx; }
.cover-rounded-lg  { border-radius: 16rpx; }
.cover-rounded-xl  { border-radius: 22rpx; }
.cover-rounded-2xl { border-radius: 28rpx; }
.cover-rounded-card { border-radius: 28rpx; }
.cover-rounded-full { border-radius: 9999rpx; }

.cover-img {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  z-index: 0;
}

.cover-text {
  position: absolute;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  z-index: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  text-align: center;
  font-size: 30rpx;
  font-weight: 600;
  padding: 0 20rpx;
  box-sizing: border-box;
  overflow: hidden;
}

.cover-corner {
  position: absolute;
  right: 8rpx;
  bottom: 8rpx;
  z-index: 2;
}
