<view wx:if="{{open}}" class="sheet-root" catchtouchmove="noop">
  <view class="sheet-mask" bindtap="onClose"></view>
  <view class="sheet-body" style="max-height:{{maxHeight}};">
    <view class="sheet-handle"></view>
    <view wx:if="{{title}}" class="sheet-title">{{title}}</view>
    <scroll-view scroll-y class="sheet-content">
      <slot></slot>
    </scroll-view>
  </view>
</view>
