.splash {
  min-height: 100vh;
  background: var(--bg-primary);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding-left: 64rpx;
  padding-right: 64rpx;
  padding-top: max(96rpx, calc(constant(safe-area-inset-top) + 16rpx));
  padding-top: max(96rpx, calc(env(safe-area-inset-top) + 16rpx));
  padding-bottom: constant(safe-area-inset-bottom);
  padding-bottom: env(safe-area-inset-bottom);
  text-align: center;
  box-sizing: border-box;
}

.splash-logo-wrap {
  position: relative;
  width: 240rpx;
  height: 240rpx;
}
.splash-logo {
  width: 100%;
  height: 100%;
  border-radius: 9999rpx;
  background: var(--bg-card);
  display: flex;
  align-items: center;
  justify-content: center;
  border: 4rpx solid rgba(165, 124, 44, 0.55);
  overflow: hidden;
  padding: 16rpx;
  box-sizing: border-box;
}
.splash-logo-img {
  width: 100%;
  height: 100%;
}
.splash-ring {
  position: absolute;
  inset: -24rpx;
  border-radius: 9999rpx;
  border: 1rpx solid rgba(165, 124, 44, 0.32);
  animation: pulseSoft 1.6s ease-in-out infinite;
}
.splash-seal {
  position: absolute;
  right: -16rpx;
  bottom: -16rpx;
}

.splash-title {
  margin-top: 64rpx;
  font-size: 48rpx;
  font-weight: 700;
  color: var(--text-primary);
  letter-spacing: 16rpx;
}
.splash-eyebrow {
  margin-top: 12rpx;
  font-size: 22rpx;
  color: rgba(165, 124, 44, 0.85);
  letter-spacing: 12rpx;
}
.splash-subtitle {
  margin-top: 16rpx;
  font-size: 26rpx;
  color: var(--text-secondary);
}

.splash-progress {
  margin-top: 80rpx;
  height: 8rpx;
  width: 240rpx;
  border-radius: 9999rpx;
  background: rgba(181, 169, 154, 0.3);
  overflow: hidden;
}
.splash-progress-bar {
  height: 100%;
  width: 50%;
  background: var(--ancient-cinnabar);
  border-radius: 9999rpx;
  animation: pulseSoft 1.4s ease-in-out infinite;
}

@keyframes pulseSoft {
  0% { opacity: 0.7; }
  50% { opacity: 0.35; }
  100% { opacity: 0.7; }
}
