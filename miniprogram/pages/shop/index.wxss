.page-root {
  min-height: 100vh;
  background: var(--bg-primary);
  padding: 24rpx 32rpx 0;
}
.tab-page { padding-bottom: calc(env(safe-area-inset-bottom) + 240rpx); }

.shop-top {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding-top: max(96rpx, calc(constant(safe-area-inset-top) + 32rpx));
  padding-top: max(96rpx, calc(env(safe-area-inset-top) + 32rpx));
  margin-bottom: 24rpx;
  box-sizing: border-box;
}
.shop-search {
  flex: 1;
  display: flex;
  align-items: center;
  gap: 16rpx;
  background: var(--bg-card);
  border: 1rpx solid rgba(165, 124, 44, 0.5);
  border-radius: 9999rpx;
  padding: 18rpx 28rpx;
  color: var(--text-secondary);
}
.shop-search-text { font-size: 30rpx; }
.cart-btn {
  position: relative;
  width: 88rpx;
  height: 88rpx;
  border-radius: 9999rpx;
  background: var(--bg-card);
  border: 1rpx solid rgba(165,124,44,0.5);
  display: flex;
  align-items: center;
  justify-content: center;
}
.cart-badge {
  position: absolute;
  right: -4rpx;
  top: -4rpx;
  min-width: 28rpx;
  height: 28rpx;
  padding: 0 8rpx;
  border-radius: 9999rpx;
  background: var(--ancient-red);
  color: #fff;
  font-size: 22rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.shop-banner { width: 100%; margin-bottom: 16rpx; }
.shop-banner-swiper {
  width: 100%;
  height: 280rpx;
  border-radius: 28rpx;
  overflow: hidden;
}
.shop-banner-sub {
  margin-top: 12rpx;
  text-align: center;
  font-size: 26rpx;
  color: var(--text-secondary);
}
.shop-banner-dots {
  display: flex;
  justify-content: center;
  gap: 8rpx;
  margin-top: 8rpx;
}
.shop-banner-dot {
  width: 12rpx; height: 12rpx; border-radius: 9999rpx;
  background: rgba(181,169,154,0.5);
  transition: width 0.2s;
}
.shop-banner-dot.on { width: 36rpx; background: var(--neon-teal); }

.shop-tabs {
  display: flex;
  gap: 16rpx;
  white-space: nowrap;
  padding: 8rpx 0;
  margin-top: 16rpx;
}
.shop-chip {
  display: inline-block;
  padding: 12rpx 28rpx;
  background: var(--bg-card);
  border: 1rpx solid var(--divider-color);
  color: var(--text-secondary);
  border-radius: 9999rpx;
  font-size: 28rpx;
  margin-right: 16rpx;
}
.shop-chip.on { background: var(--neon-teal); border-color: var(--neon-teal); color: #ffffff; }

.product-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 24rpx;
  margin-top: 24rpx;
}
.product-card {
  display: flex;
  flex-direction: column;
  background: var(--bg-card);
  border: 1rpx solid rgba(165,124,44,0.4);
  border-radius: 22rpx;
  overflow: hidden;
}
.product-info { padding: 16rpx; flex: 1; }
.product-name {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text-primary);
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}
.product-price-row {
  margin-top: 8rpx;
  display: flex;
  align-items: baseline;
  gap: 8rpx;
}
.product-price {
  color: var(--ancient-cinnabar);
  font-size: 30rpx;
  font-weight: 700;
}
.product-orig {
  color: var(--text-hint);
  text-decoration: line-through;
  font-size: 24rpx;
}
.product-meta {
  margin-top: 8rpx;
  display: flex;
  justify-content: space-between;
  font-size: 24rpx;
  color: var(--text-hint);
}
.product-rating { color: var(--ancient-bronze); }
.product-add {
  margin: 0 16rpx 16rpx;
  padding: 12rpx 0;
  border-radius: 9999rpx;
  border: 1rpx solid rgba(165,124,44,0.5);
  color: var(--ancient-bronze);
  text-align: center;
  font-size: 26rpx;
}

.loadmore-btn {
  margin: 32rpx 0;
  padding: 20rpx 0;
  text-align: center;
  border-radius: 9999rpx;
  background: var(--bg-card);
  border: 1rpx solid rgba(165,124,44,0.5);
  color: var(--text-secondary);
  font-size: 30rpx;
}
.loadmore-end {
  margin: 32rpx 0;
  text-align: center;
  font-size: 26rpx;
  color: var(--text-hint);
}
