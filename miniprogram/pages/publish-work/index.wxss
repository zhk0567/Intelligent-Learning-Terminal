.page-root { min-height: 100vh; background: var(--bg-primary); }
.publish-cta {
  font-size: 28rpx;
  color: var(--ancient-cinnabar);
  font-weight: 600;
  padding: 8rpx 16rpx;
}
.publish-body { padding: 24rpx 32rpx 80rpx; display: flex; flex-direction: column; gap: 24rpx; }

.picker-card {
  background: var(--bg-card);
  border: 1rpx solid var(--divider-color);
  border-radius: 22rpx;
  padding: 24rpx;
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 16rpx;
}
.picker-cell {
  aspect-ratio: 1 / 1;
  border-radius: 22rpx;
  border: 2rpx dashed rgba(181,169,154,0.6);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  color: var(--text-hint);
}
.picker-label {
  font-size: 22rpx;
  color: var(--text-hint);
}

.form-input {
  background: var(--bg-card);
  border: 1rpx solid var(--divider-color);
  border-radius: 22rpx;
  padding: 24rpx;
  font-size: 28rpx;
  color: var(--text-primary);
}
.form-textarea {
  background: var(--bg-card);
  border: 1rpx solid var(--divider-color);
  border-radius: 22rpx;
  padding: 24rpx;
  font-size: 28rpx;
  color: var(--text-primary);
  width: 100%;
  box-sizing: border-box;
  min-height: 240rpx;
}
.auth-placeholder { color: var(--text-hint); }

.form-section { display: flex; flex-direction: column; gap: 16rpx; }
.form-section-title {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--text-primary);
}
.chip-row { display: flex; flex-wrap: wrap; gap: 16rpx; align-items: center; }
.form-chip {
  padding: 8rpx 24rpx;
  background: var(--bg-card);
  border: 1rpx solid var(--divider-color);
  color: var(--text-secondary);
  border-radius: 9999rpx;
  font-size: 22rpx;
}
.form-chip.on {
  background: var(--ancient-cinnabar);
  border-color: var(--ancient-cinnabar);
  color: #ffffff;
  box-shadow: inset 0 -3rpx 0 rgba(0,0,0,0.2);
}
.tag-chip {
  border: 1rpx solid rgba(165,124,44,0.5);
  color: var(--ancient-bronze);
  font-size: 22rpx;
  padding: 4rpx 16rpx;
  border-radius: 9999rpx;
}
.tag-input-wrap {
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
}
.tag-input {
  font-size: 22rpx;
  color: var(--text-primary);
  min-width: 200rpx;
}
