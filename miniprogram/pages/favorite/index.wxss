.page-root { min-height: 100vh; background: var(--bg-primary); padding-bottom: 60rpx; }
.fav-body { padding: 16rpx 24rpx; }

.tab-row { display: flex; gap: 16rpx; }
.tab-chip {
  padding: 12rpx 24rpx;
  border-radius: 9999rpx;
  font-size: 24rpx;
  background: var(--bg-card);
  border: 1rpx solid var(--divider-color);
  color: var(--text-secondary);
}
.tab-chip.on {
  background: var(--ancient-cinnabar);
  border-color: var(--ancient-cinnabar);
  color: #ffffff;
  box-shadow: inset 0 -3rpx 0 rgba(0,0,0,0.2);
}

.fav-list { margin-top: 24rpx; display: flex; flex-direction: column; gap: 16rpx; }
.fav-row {
  display: flex;
  gap: 16rpx;
  padding: 16rpx;
  background: var(--bg-card);
  border: 1rpx solid var(--divider-color);
  border-radius: 18rpx;
  align-items: stretch;
}
.fav-cover { width: 96rpx; height: 96rpx; flex-shrink: 0; }
.fav-info { flex: 1; min-width: 0; align-self: stretch; }
.fav-title {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--text-primary);
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}
.fav-sub {
  font-size: 22rpx;
  color: var(--text-secondary);
  margin-top: 6rpx;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}
.fav-sub-clip {
  white-space: normal;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
}

.fav-grid {
  margin-top: 24rpx;
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 16rpx;
}
.fav-card {
  background: var(--bg-card);
  border: 1rpx solid var(--divider-color);
  border-radius: 18rpx;
  overflow: hidden;
}
.fav-card-body { padding: 16rpx; }
.fav-card-name {
  font-size: 24rpx;
  color: var(--text-primary);
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}
.fav-card-price {
  margin-top: 8rpx;
  color: var(--ancient-cinnabar);
  font-weight: 700;
  font-size: 26rpx;
}
