.page-root {
  min-height: 100vh;
  background: var(--bg-primary);
  padding: 24rpx 32rpx 0;
}
.tab-page {
  padding-bottom: calc(env(safe-area-inset-bottom) + 240rpx);
}

.music-top {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding-top: max(96rpx, calc(constant(safe-area-inset-top) + 32rpx));
  padding-top: max(96rpx, calc(env(safe-area-inset-top) + 32rpx));
  margin-bottom: 24rpx;
  box-sizing: border-box;
}
.music-search {
  flex: 1;
  display: flex;
  align-items: center;
  gap: 16rpx;
  background: var(--bg-card);
  border: 1rpx solid rgba(165, 124, 44, 0.5);
  border-radius: 9999rpx;
  padding: 18rpx 28rpx;
  color: var(--text-secondary);
}
.music-search-text {
  font-size: 30rpx;
}

.music-banner {
  width: 100%;
  margin-bottom: 8rpx;
}
.music-banner-swiper {
  width: 100%;
  height: 360rpx;
  border-radius: 28rpx;
  overflow: hidden;
}
.music-banner-sub {
  margin-top: 16rpx;
  text-align: center;
  font-size: 26rpx;
  color: var(--text-secondary);
}
.music-banner-dots {
  display: flex;
  justify-content: center;
  gap: 8rpx;
  margin-top: 12rpx;
}
.music-banner-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 9999rpx;
  background: rgba(181,169,154,0.5);
  transition: width 0.2s;
}
.music-banner-dot.on {
  width: 36rpx;
  background: var(--neon-teal);
}

.more-link {
  font-size: 26rpx;
  color: var(--text-hint);
}

.album-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 24rpx;
}
.album-card {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}
.album-card-title {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--text-primary);
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}
.album-card-desc {
  font-size: 26rpx;
  color: var(--text-secondary);
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.album-row-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}
.album-row {
  display: flex;
  align-items: flex-start;
  gap: 24rpx;
  padding: 16rpx;
  background: var(--bg-card-elevated);
  border: 1rpx solid var(--divider-color);
  border-radius: 22rpx;
}
.album-row-cover {
  width: 120rpx;
  height: 120rpx;
  flex-shrink: 0;
}
.album-row-info {
  flex: 1;
  min-width: 0;
}
.album-row-title {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--text-primary);
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}
.album-row-desc {
  font-size: 26rpx;
  color: var(--text-secondary);
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
  margin-top: 4rpx;
}
.album-row-cta {
  font-size: 26rpx;
  color: var(--ancient-cinnabar);
  font-weight: 600;
  flex-shrink: 0;
  align-self: center;
}
