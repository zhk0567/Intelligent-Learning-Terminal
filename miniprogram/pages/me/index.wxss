.page-root {
  min-height: 100vh;
  background: var(--bg-primary);
}
.tab-page { padding-bottom: calc(env(safe-area-inset-bottom) + 240rpx); }

.me-head {
  background: var(--bg-secondary);
  padding-left: 32rpx;
  padding-right: 32rpx;
  padding-bottom: 32rpx;
  padding-top: max(96rpx, calc(constant(safe-area-inset-top) + 32rpx));
  padding-top: max(96rpx, calc(env(safe-area-inset-top) + 32rpx));
  box-sizing: border-box;
}
.me-head-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.me-title {
  font-size: 42rpx;
  font-weight: 700;
  color: var(--text-primary);
}
.me-actions {
  display: flex;
  gap: 16rpx;
}

.me-user {
  margin-top: 32rpx;
  display: flex;
  align-items: center;
  gap: 24rpx;
}
.me-avatar-wrap {
  position: relative;
  width: 128rpx;
  height: 128rpx;
  flex-shrink: 0;
}
.me-avatar {
  width: 128rpx;
  height: 128rpx;
  border: 4rpx solid rgba(165,124,44,0.55);
  box-sizing: border-box;
}
.me-vip {
  position: absolute;
  right: -8rpx;
  bottom: -8rpx;
}
.me-user-info {
  flex: 1;
  min-width: 0;
}
.me-user-name {
  font-size: 36rpx;
  font-weight: 700;
  color: var(--text-primary);
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}
.me-user-bio {
  margin-top: 8rpx;
  font-size: 26rpx;
  color: var(--text-secondary);
}
.me-user-phone {
  margin-top: 4rpx;
  font-size: 26rpx;
  color: var(--text-hint);
}
.me-edit-btn {
  flex-shrink: 0;
  padding: 12rpx 24rpx;
  border: 1rpx solid var(--divider-color);
  border-radius: 9999rpx;
  font-size: 26rpx;
  color: var(--text-primary);
  background: transparent;
}

.me-stats {
  margin: 24rpx 32rpx 0;
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 16rpx;
  background: var(--bg-card);
  border: 1rpx solid var(--divider-color);
  border-radius: 28rpx;
  padding: 24rpx;
}
.me-stat {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
  background: var(--bg-card-elevated);
  border: 1rpx solid var(--divider-color);
  border-radius: 22rpx;
  padding: 24rpx 0;
}
.me-stat-num {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--text-primary);
}
.me-stat-label {
  font-size: 26rpx;
  color: var(--text-secondary);
}

.me-functions {
  margin: 24rpx 32rpx 0;
  background: var(--bg-card);
  border: 1rpx solid var(--divider-color);
  border-radius: 28rpx;
  padding: 24rpx;
}
.me-functions-head {
  display: flex;
  align-items: center;
  margin-bottom: 16rpx;
}
.me-functions-title {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--text-primary);
}
.me-functions-eyebrow {
  font-size: 22rpx;
  letter-spacing: 4rpx;
  color: rgba(165,124,44,0.85);
  margin-top: 4rpx;
}
.me-func-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}
.me-func {
  display: flex;
  align-items: center;
  gap: 24rpx;
  padding: 24rpx;
  background: var(--bg-card-elevated);
  border: 1rpx solid var(--divider-color);
  border-radius: 22rpx;
}
.me-func-icon {
  width: 80rpx;
  height: 80rpx;
  border-radius: 16rpx;
  background: rgba(183,56,46,0.1);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}
.me-func-info { flex: 1; min-width: 0; }
.me-func-label {
  display: block;
  font-size: 32rpx;
  font-weight: 600;
  color: var(--text-primary);
}
.me-func-desc {
  display: block;
  font-size: 26rpx;
  color: var(--text-secondary);
  margin-top: 4rpx;
}
.me-func-arrow {
  color: var(--text-hint);
  font-size: 32rpx;
  flex-shrink: 0;
}
