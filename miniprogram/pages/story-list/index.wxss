.page-root { min-height: 100vh; background: var(--bg-primary); }
.story-list-body {
  padding: 24rpx 32rpx 80rpx;
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}
.story-card {
  background: var(--bg-card);
  border: 1rpx solid var(--divider-color);
  border-radius: 28rpx;
  overflow: hidden;
}
.story-card-info { padding: 24rpx; }
.story-card-title {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--text-primary);
}
.story-card-excerpt {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: var(--text-secondary);
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}
.story-card-meta {
  margin-top: 12rpx;
  display: flex;
  justify-content: space-between;
  font-size: 22rpx;
  color: var(--text-hint);
}
.story-card-meta .cinnabar { color: var(--ancient-cinnabar); }
.story-card-tags {
  margin-top: 12rpx;
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
}
.story-tag {
  border: 1rpx solid rgba(165,124,44,0.5);
  color: var(--ancient-bronze);
  border-radius: 9999rpx;
  font-size: 20rpx;
  padding: 4rpx 16rpx;
}
