<view class="page-root {{__themeClass}}">
  <top-bar title="确认订单" />

  <view class="order-body">
    <view class="addr-card" bindtap="goAddr">
      <view class="addr-pin"><icon name="map-pin" size="40" color="var(--ancient-cinnabar)" /></view>
      <view class="addr-info">
        <view class="addr-name">
          <text class="addr-text">{{addr.name}}</text>
          <text class="addr-phone">{{addr.phone}}</text>
          <text wx:if="{{addr.isDefault}}" class="addr-tag">默认</text>
        </view>
        <view class="addr-detail">{{addr.detail}}</view>
      </view>
      <text class="addr-arrow">›</text>
    </view>

    <view class="order-card">
      <view wx:for="{{items}}" wx:key="productId" class="order-item">
        <cover extra-class="order-cover" seed="{{item.product.id}}" src="{{item.product.imageSrc}}"
               alt="{{item.product.name}}" aspect="square" rounded="lg" ornate="{{false}}" />
        <view class="order-item-info">
          <view class="order-item-name">{{item.product.name}}</view>
          <view class="order-item-spec">标准款</view>
          <view class="order-item-bottom">
            <text class="order-item-price">¥{{item.product.price}}</text>
            <text class="order-item-count">x{{item.count}}</text>
          </view>
        </view>
      </view>
    </view>

    <view class="order-card">
      <view class="row-line"><text class="row-label">商品金额</text><text class="row-value">¥{{subtotalText}}</text></view>
      <view class="row-line"><text class="row-label">运费</text><text class="row-value">{{shipText}}</text></view>
      <view class="row-line"><text class="row-label">优惠券</text><text class="row-value">暂无可用</text></view>
    </view>

    <view class="order-card">
      <view class="order-card-head">
        <view class="section-bar"></view>
        <text class="order-card-title">支付方式</text>
      </view>
      <view wx:for="{{methods}}" wx:key="id" class="pay-row" data-id="{{item.id}}" bindtap="pickPay">
        <view class="pay-icon" style="background:{{item.color}};">{{item.short}}</view>
        <text class="pay-label">{{item.label}}</text>
        <view class="check {{pay === item.id ? 'on' : ''}}"></view>
      </view>
    </view>
  </view>

  <view class="order-bar">
    <view class="order-bar-total">实付：<text class="order-bar-num">¥{{totalText}}</text></view>
    <view class="btn btn-stamp order-cta" bindtap="submit">提交订单</view>
  </view>
</view>
