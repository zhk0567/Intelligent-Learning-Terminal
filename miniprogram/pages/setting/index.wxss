.page-root { min-height: 100vh; background: var(--bg-primary); }
.setting-body { padding: 16rpx 24rpx 60rpx; display: flex; flex-direction: column; gap: 24rpx; }

.setting-group {
  background: var(--bg-card);
  border: 1rpx solid var(--divider-color);
  border-radius: 22rpx;
  padding: 24rpx;
}
.setting-head { display: flex; align-items: center; padding-bottom: 16rpx; }
.setting-title { font-size: 26rpx; font-weight: 700; color: var(--text-primary); }
.setting-eyebrow { font-size: 18rpx; letter-spacing: 0.18em; color: rgba(165,124,44,0.85); }

.setting-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 18rpx 16rpx;
  background: rgba(212,212,212,0.06);
  border: 1rpx solid var(--divider-color);
  border-radius: 18rpx;
  margin-top: 12rpx;
}
.setting-row-icon {
  width: 56rpx; height: 56rpx;
  border-radius: 16rpx;
  background: rgba(183,56,46,0.1);
  display: flex; align-items: center; justify-content: center;
}
.setting-row-label {
  flex: 1;
  font-size: 26rpx;
  color: var(--text-primary);
}
.setting-row-label-only {
  flex: 1;
  font-size: 26rpx;
  color: var(--text-primary);
  margin-left: 16rpx;
}
.setting-row-value { font-size: 22rpx; color: var(--text-hint); }
.setting-row-arrow { color: var(--text-hint); font-size: 32rpx; }

.logout-btn {
  margin-top: 24rpx;
  padding: 24rpx 0;
  text-align: center;
  background: var(--bg-card);
  border: 1rpx solid var(--divider-color);
  border-radius: 28rpx;
  color: var(--ancient-cinnabar);
  font-size: 26rpx;
  font-weight: 600;
}

.dlg-mask {
  position: fixed; inset: 0; z-index: 100;
  background: rgba(0,0,0,0.45);
  display: flex; align-items: center; justify-content: center;
  padding: 40rpx;
}
.dlg {
  width: 100%;
  max-width: 600rpx;
  background: var(--bg-card);
  border: 1rpx solid var(--divider-color);
  border-radius: 28rpx;
  padding: 32rpx;
}
.dlg-title { font-size: 30rpx; font-weight: 700; color: var(--text-primary); }
.dlg-body { margin-top: 24rpx; display: flex; flex-direction: column; gap: 16rpx; }

.theme-opt {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 18rpx;
  background: rgba(212,212,212,0.06);
  border: 1rpx solid var(--divider-color);
  border-radius: 22rpx;
}
.theme-opt.on {
  background: rgba(183,56,46,0.08);
  border-color: rgba(183,56,46,0.6);
}
.check {
  width: 32rpx; height: 32rpx; border-radius: 9999rpx;
  border: 4rpx solid var(--border-color);
}
.check.on { background: var(--ancient-cinnabar); border-color: var(--ancient-cinnabar); }
.theme-icon { font-size: 36rpx; color: var(--ancient-bronze); }
.theme-info { flex: 1; }
.theme-label { font-size: 26rpx; font-weight: 600; color: var(--text-primary); }
.theme-desc { font-size: 22rpx; color: var(--text-secondary); margin-top: 4rpx; }

.dlg-actions {
  margin-top: 32rpx;
  display: flex;
  justify-content: flex-end;
  gap: 16rpx;
}
.dlg-btn {
  padding: 14rpx 32rpx;
  border-radius: 9999rpx;
  font-size: 26rpx;
  color: var(--text-secondary);
}
.dlg-btn.confirm {
  background: var(--neon-teal);
  color: #ffffff;
  box-shadow: inset 0 -4rpx 0 rgba(0,0,0,0.18);
}
