.page-root { min-height: 100vh; background: var(--bg-primary); padding-bottom: 160rpx; }
.story-hero { width: 100%; }
.story-detail-body { padding: 24rpx 32rpx 32rpx; }
.story-detail-title {
  font-size: 38rpx;
  font-weight: 700;
  color: var(--text-primary);
}
.story-detail-meta {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: var(--text-hint);
}
.story-detail-tags {
  margin-top: 12rpx;
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
}
.story-tag {
  border: 1rpx solid rgba(165,124,44,0.5);
  color: var(--ancient-bronze);
  border-radius: 9999rpx;
  font-size: 20rpx;
  padding: 4rpx 16rpx;
}
.story-detail-text {
  margin-top: 24rpx;
  font-size: 28rpx;
  line-height: 1.8;
  color: var(--text-primary);
  white-space: pre-line;
}

.comments-card {
  margin-top: 32rpx;
  padding: 24rpx;
  background: var(--bg-card);
  border: 1rpx solid var(--divider-color);
  border-radius: 28rpx;
}
.comments-head {
  display: flex;
  align-items: center;
  margin-bottom: 16rpx;
}
.comments-title {
  font-size: 26rpx;
  font-weight: 700;
  color: var(--text-primary);
}
.comments-list { display: flex; flex-direction: column; gap: 16rpx; }
.comment-row {
  display: flex;
  gap: 16rpx;
}
.comment-avatar {
  width: 56rpx;
  height: 56rpx;
  border-radius: 9999rpx;
  background: var(--bg-card-elevated);
  border: 1rpx solid rgba(165,124,44,0.5);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 22rpx;
  font-weight: 700;
  color: var(--ancient-bronze);
  flex-shrink: 0;
}
.comment-info { flex: 1; min-width: 0; }
.comment-name {
  font-size: 24rpx;
  color: var(--text-primary);
  font-weight: 600;
}
.comment-text {
  margin-top: 4rpx;
  font-size: 22rpx;
  color: var(--text-secondary);
}

.story-input-bar {
  position: fixed;
  bottom: 0; left: 0; right: 0;
  z-index: 30;
  padding: 16rpx 24rpx calc(env(safe-area-inset-bottom) + 16rpx);
  background: var(--bg-card);
  border-top: 1rpx solid var(--divider-color);
  display: flex;
  align-items: center;
  gap: 12rpx;
}
.story-input-action {
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
.story-input {
  flex: 1;
  border-radius: 9999rpx;
  background: var(--bg-card-elevated);
  border: 1rpx solid var(--divider-color);
  padding: 12rpx 24rpx;
  font-size: 26rpx;
  color: var(--text-primary);
}
.auth-placeholder { color: var(--text-hint); }
.story-input-send {
  width: 64rpx;
  height: 64rpx;
  border-radius: 9999rpx;
  background: var(--neon-teal);
  display: flex;
  align-items: center;
  justify-content: center;
}
