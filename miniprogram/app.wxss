/**
 * 与 web/src/theme/tokens.ts、web/src/index.css 对齐的设计令牌与原子工具类。
 * 通过 page.theme-light / page.theme-dark 切换。
 */

page,
.theme-light,
.theme-dark {
  --ancient-cinnabar: #b7382e;
  --ancient-cinnabar-soft: #c45347;
  --ancient-bronze: #a57c2c;
  --ancient-bronze-soft: #b88f3d;
  --ancient-jade: #00a86b;
  --ancient-celadon: #7da9a0;
  --ancient-rice: #f4efe6;
  --ancient-ink: #1b2230;
  --neon-teal: #2ec4b6;
  --neon-cyan: #00ffff;
  --ancient-red: #c91f37;
}

page,
.theme-light {
  --bg-primary: #f4efe6;
  --bg-secondary: #ebe3d3;
  --bg-card: #ffffff;
  --bg-card-elevated: #fbf7ee;

  --text-primary: #1f1b16;
  --text-secondary: #5c5346;
  --text-hint: #8c7e6a;

  --border-color: #b5a99a;
  --divider-color: #d6cdb8;

  --player-screen: #ebe3d3;
  --player-control: #1f1b16;
  --player-chip: #ffffff;
  --player-frame: #fbf7ee;
  --mini-surface: #ffffff;
}

.theme-dark {
  --bg-primary: #0a0e17;
  --bg-secondary: #111827;
  --bg-card: #1a2332;
  --bg-card-elevated: #222e3f;

  --text-primary: #f2efea;
  --text-secondary: #b7b0a4;
  --text-hint: #7a8290;

  --border-color: rgba(212, 212, 212, 0.22);
  --divider-color: rgba(212, 212, 212, 0.12);

  --player-screen: #0a101f;
  --player-control: #c2933c;
  --player-chip: #1a2332;
  --player-frame: #0a101f;
  --mini-surface: #1a2332;
}

page {
  background: var(--bg-primary);
  color: var(--text-primary);
  font-family: -apple-system, "PingFang SC", "Microsoft YaHei", "Segoe UI", Roboto, sans-serif;
  font-size: 32rpx;
  min-height: 100vh;
  box-sizing: border-box;
}

view, text, button, image, scroll-view, input, textarea {
  box-sizing: border-box;
}

button {
  background: transparent;
  padding: 0;
  margin: 0;
  border: none;
  line-height: normal;
  font-size: inherit;
  color: inherit;
}
button::after {
  border: none;
}

/* ===== 文字尺寸（移动端可读性略放大） ===== */
.text-xs { font-size: 26rpx; line-height: 1.5; }
.text-sm { font-size: 30rpx; line-height: 1.55; }
.text-base { font-size: 34rpx; line-height: 1.55; }
.text-lg { font-size: 38rpx; line-height: 1.45; }
.text-xl { font-size: 42rpx; line-height: 1.4; }
.text-2xl { font-size: 50rpx; line-height: 1.35; }

.text-primary { color: var(--text-primary); }
.text-secondary { color: var(--text-secondary); }
.text-hint { color: var(--text-hint); }
.text-cinnabar { color: var(--ancient-cinnabar); }
.text-bronze { color: var(--ancient-bronze); }
.text-teal { color: var(--neon-teal); }
.text-white { color: #ffffff; }

.font-bold { font-weight: 700; }
.font-semibold { font-weight: 600; }
.font-medium { font-weight: 500; }

/* ===== 颜色块 ===== */
.bg-primary { background: var(--bg-primary); }
.bg-secondary { background: var(--bg-secondary); }
.bg-card { background: var(--bg-card); }
.bg-card-elevated { background: var(--bg-card-elevated); }
.bg-cinnabar { background: var(--ancient-cinnabar); }
.bg-bronze { background: var(--ancient-bronze); }
.bg-teal { background: var(--neon-teal); }
.bg-mini-surface { background: var(--mini-surface); }

.border { border: 1rpx solid var(--border-color); }
.border-soft { border: 1rpx solid rgba(165, 124, 44, 0.4); }
.border-strong { border: 1rpx solid rgba(165, 124, 44, 0.6); }
.border-bronze { border: 1rpx solid rgba(165, 124, 44, 0.55); }
.border-divider { border-bottom: 1rpx solid var(--divider-color); }
.border-top { border-top: 1rpx solid var(--divider-color); }

/* ===== 圆角 ===== */
.rounded-sm { border-radius: 6rpx; }
.rounded-md { border-radius: 12rpx; }
.rounded-lg { border-radius: 16rpx; }
.rounded-xl { border-radius: 22rpx; }
.rounded-2xl { border-radius: 28rpx; }
.rounded-card { border-radius: 28rpx; }
.rounded-full { border-radius: 9999rpx; }

/* ===== 间距（Tailwind 1=4px = 8rpx） ===== */
.p-1 { padding: 8rpx; }
.p-2 { padding: 16rpx; }
.p-3 { padding: 24rpx; }
.p-4 { padding: 32rpx; }
.p-5 { padding: 40rpx; }

.px-1 { padding-left: 8rpx; padding-right: 8rpx; }
.px-2 { padding-left: 16rpx; padding-right: 16rpx; }
.px-3 { padding-left: 24rpx; padding-right: 24rpx; }
.px-4 { padding-left: 32rpx; padding-right: 32rpx; }
.px-5 { padding-left: 40rpx; padding-right: 40rpx; }

.py-1 { padding-top: 8rpx; padding-bottom: 8rpx; }
.py-1-5 { padding-top: 12rpx; padding-bottom: 12rpx; }
.py-2 { padding-top: 16rpx; padding-bottom: 16rpx; }
.py-3 { padding-top: 24rpx; padding-bottom: 24rpx; }
.py-4 { padding-top: 32rpx; padding-bottom: 32rpx; }

.pt-2 { padding-top: 16rpx; }
.pt-3 { padding-top: 24rpx; }
.pb-2 { padding-bottom: 16rpx; }
.pb-3 { padding-bottom: 24rpx; }
.pb-6 { padding-bottom: 48rpx; }
.pb-10 { padding-bottom: 80rpx; }
.pb-24 { padding-bottom: 192rpx; }

.m-0 { margin: 0; }
.mt-1 { margin-top: 8rpx; }
.mt-2 { margin-top: 16rpx; }
.mt-3 { margin-top: 24rpx; }
.mt-4 { margin-top: 32rpx; }
.mb-2 { margin-bottom: 16rpx; }
.mr-2 { margin-right: 16rpx; }
.mr-3 { margin-right: 24rpx; }

.mx-3 { margin-left: 24rpx; margin-right: 24rpx; }

/* ===== flex 布局 ===== */
.flex { display: flex; }
.inline-flex { display: inline-flex; }
.flex-col { flex-direction: column; }
.flex-row { flex-direction: row; }
.flex-wrap { flex-wrap: wrap; }
.items-center { align-items: center; }
.items-start { align-items: flex-start; }
.items-end { align-items: flex-end; }
.items-baseline { align-items: baseline; }
.justify-center { justify-content: center; }
.justify-between { justify-content: space-between; }
.justify-around { justify-content: space-around; }
.justify-end { justify-content: flex-end; }
.flex-1 { flex: 1 1 0%; min-width: 0; }
.flex-none { flex: none; }
.shrink-0 { flex-shrink: 0; }

.gap-1 { gap: 8rpx; }
.gap-2 { gap: 16rpx; }
.gap-3 { gap: 24rpx; }
.gap-4 { gap: 32rpx; }

.grid { display: grid; }
.grid-cols-2 { grid-template-columns: repeat(2, minmax(0, 1fr)); }
.grid-cols-3 { grid-template-columns: repeat(3, minmax(0, 1fr)); }
.grid-cols-4 { grid-template-columns: repeat(4, minmax(0, 1fr)); }
.grid-cols-5 { grid-template-columns: repeat(5, minmax(0, 1fr)); }

.relative { position: relative; }
.absolute { position: absolute; }
.fixed { position: fixed; }
.inset-0 { top: 0; right: 0; bottom: 0; left: 0; }

.w-full { width: 100%; }
.h-full { height: 100%; }
.min-w-0 { min-width: 0; }
.max-w-full { max-width: 100%; }

.text-left { text-align: left; }
.text-center { text-align: center; }
.text-right { text-align: right; }

.overflow-hidden { overflow: hidden; }
.overflow-auto { overflow: auto; }
.truncate { overflow: hidden; white-space: nowrap; text-overflow: ellipsis; }

/* 多行省略 */
.line-clamp-1 {
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 1;
  overflow: hidden;
}
.line-clamp-2 {
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}
.line-clamp-3 {
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 3;
  overflow: hidden;
}

/* ===== 卡片悬浮（小程序无 hover，主要用于 transition） ===== */
.card-hover {
  transition: transform 0.2s ease, box-shadow 0.2s ease;
}

/* ===== 非遗按钮三件套 ===== */
.btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 14rpx;
  padding: 22rpx 40rpx;
  border-radius: 9999rpx;
  font-size: 32rpx;
  line-height: 1;
  transition: transform 0.15s ease, opacity 0.15s ease;
}

.btn-primary {
  background: var(--neon-teal);
  color: #ffffff;
  box-shadow: inset 0 -4rpx 0 rgba(0, 0, 0, 0.18);
}
.btn-stamp {
  background: var(--ancient-cinnabar);
  color: #ffffff;
  box-shadow: inset 0 -4rpx 0 rgba(0, 0, 0, 0.22);
}
.btn-stamp.btn-pressed { transform: translateY(1rpx); opacity: 0.9; }

.btn-ghost {
  background: transparent;
  color: var(--text-primary);
  border: 1rpx solid var(--border-color);
}

.btn-bronze {
  background: var(--ancient-bronze);
  color: #ffffff;
}

/* 圆形小图标按钮（搜索/铃铛） */
.icon-btn {
  width: 84rpx;
  height: 84rpx;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  background: var(--bg-card);
  border-radius: 9999rpx;
  border: 1rpx solid rgba(165, 124, 44, 0.4);
  color: var(--text-primary);
}

/* ===== Section 章节卡 + 朱砂红竖条 ===== */
.section-bar {
  display: inline-block;
  width: 6rpx;
  height: 32rpx;
  border-radius: 3rpx;
  background: var(--ancient-cinnabar);
  margin-right: 16rpx;
}
.section-bar-sm {
  display: inline-block;
  width: 6rpx;
  height: 24rpx;
  border-radius: 3rpx;
  background: var(--ancient-cinnabar);
  margin-right: 16rpx;
}

/* ===== 滚动行隐藏滚动条（横向 chip） ===== */
.no-scrollbar ::-webkit-scrollbar {
  display: none;
}

/* ===== 安全区与底部留白（custom tabBar 高 132rpx） ===== */
/* 自定义导航顶部：与刘海/状态栏/胶囊留白，env 为 0 时仍有下限（约 48px） */
.pt-safe-nav {
  padding-top: max(96rpx, calc(constant(safe-area-inset-top) + 32rpx));
  padding-top: max(96rpx, calc(env(safe-area-inset-top) + 32rpx));
  box-sizing: border-box;
}

.safe-bottom {
  padding-bottom: calc(env(safe-area-inset-bottom) + 24rpx);
}

.tab-page {
  padding-bottom: calc(env(safe-area-inset-bottom) + 132rpx + 96rpx); /* tabBar + miniPlayer */
}

.tab-page-no-mini {
  padding-bottom: calc(env(safe-area-inset-bottom) + 132rpx);
}

/* ===== 通用进度条 ===== */
.progress-track {
  height: 6rpx;
  border-radius: 999rpx;
  background: var(--divider-color);
  overflow: hidden;
}
.progress-bar {
  height: 100%;
  border-radius: 999rpx;
  background: var(--ancient-cinnabar);
}

/* ===== 空状态文字 ===== */
.empty-text {
  text-align: center;
  color: var(--text-hint);
  font-size: 30rpx;
  padding: 80rpx 0;
}

/* 阴影 */
.shadow-card {
  box-shadow: 0 2rpx 12rpx rgba(31, 27, 22, 0.12);
}
.shadow-stamp-inset {
  box-shadow: inset 0 -4rpx 0 rgba(0, 0, 0, 0.22);
}
