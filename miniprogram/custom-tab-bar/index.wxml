<view class="tab-wrap {{__themeClass}}">
  <!-- MiniPlayer 仅在 Tab 页常驻；点击跳到播放器 -->
  <view class="mini-player" bindtap="goPlayer">
    <cover extra-class="mini-cover" seed="{{track.id}}" src="{{track.coverSrc}}" alt="{{track.title}}"
           aspect="square" rounded="lg" ornate="{{false}}" />
    <view class="mini-info">
      <view class="mini-title">{{track.title}}</view>
      <view class="mini-sub">{{track.artist}} · {{track.album}}</view>
    </view>
    <view class="mini-control" catchtap="onPrev">
      <icon name="skip-back" size="40" color="var(--text-primary)" />
    </view>
    <view class="mini-toggle" catchtap="onToggle">
      <icon name="{{isPlaying ? 'pause' : 'play'}}" size="40" color="#ffffff" />
    </view>
    <view class="mini-control" catchtap="onNext">
      <icon name="skip-forward" size="40" color="var(--text-primary)" />
    </view>
  </view>

  <!-- TabBar：5 项 -->
  <view class="tab-bar">
    <view wx:for="{{list}}" wx:key="pagePath"
          class="tab-item {{selected === index ? 'on' : ''}}"
          data-i="{{index}}" data-path="{{item.pagePath}}" bindtap="onTap">
      <view wx:if="{{selected === index}}" class="tab-active-bar"></view>
      <view class="tab-icon-wrap">
        <icon name="{{item.icon}}" size="44"
              color="{{selected === index ? 'var(--neon-teal)' : 'var(--text-hint)'}}" />
        <view wx:if="{{item.pagePath === 'pages/shop/index' && cart > 0}}" class="tab-badge">{{cart > 99 ? '99+' : cart}}</view>
      </view>
      <text class="tab-label">{{item.text}}</text>
    </view>
  </view>
</view>
