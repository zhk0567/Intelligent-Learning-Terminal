.tab-wrap {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  z-index: 50;
  display: flex;
  flex-direction: column;
  pointer-events: none;
}

.mini-player {
  pointer-events: auto;
  margin: 0 24rpx 8rpx;
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 12rpx;
  border-radius: 9999rpx;
  background: transparent;
  border: none;
  box-shadow: none;
}
.mini-cover {
  width: 80rpx;
  height: 80rpx;
  border-radius: 16rpx;
  flex-shrink: 0;
}
.mini-info { flex: 1; min-width: 0; }
.mini-title {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text-primary);
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}
.mini-sub {
  margin-top: 4rpx;
  font-size: 24rpx;
  color: var(--text-secondary);
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}
.mini-control {
  width: 72rpx;
  height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
.mini-toggle {
  width: 80rpx;
  height: 80rpx;
  border-radius: 9999rpx;
  background: var(--ancient-cinnabar);
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: inset 0 -4rpx 0 rgba(0,0,0,0.2);
}

.tab-bar {
  pointer-events: auto;
  display: grid;
  grid-template-columns: repeat(5, 1fr);
  background: var(--bg-card);
  border-top: 1rpx solid var(--divider-color);
  padding-bottom: env(safe-area-inset-bottom);
}
.tab-item {
  position: relative;
  height: 112rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 4rpx;
}
.tab-icon-wrap {
  position: relative;
}
.tab-active-bar {
  position: absolute;
  top: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 56rpx;
  height: 6rpx;
  border-radius: 0 0 9999rpx 9999rpx;
  background: var(--ancient-cinnabar);
}
.tab-badge {
  position: absolute;
  right: -10rpx;
  top: -4rpx;
  min-width: 32rpx;
  height: 32rpx;
  padding: 0 8rpx;
  border-radius: 9999rpx;
  background: var(--ancient-cinnabar);
  color: #ffffff;
  font-size: 22rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
.tab-label {
  font-size: 24rpx;
  color: var(--text-hint);
}
.tab-item.on .tab-label {
  color: var(--neon-teal);
  font-weight: 600;
}
