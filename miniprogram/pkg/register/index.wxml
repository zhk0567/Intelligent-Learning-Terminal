<view class="page-root {{__themeClass}}">
  <top-bar title="注册账号"></top-bar>
  <view class="auth-body">
    <view class="auth-card">
      <view class="auth-field">
        <icon name="user" size="36" color="var(--text-hint)" />
        <input class="auth-input" placeholder="昵称" placeholder-class="auth-placeholder"
               value="{{name}}" bindinput="onName" />
      </view>
      <view class="auth-field">
        <icon name="phone" size="36" color="var(--text-hint)" />
        <input class="auth-input" type="number" maxlength="11" placeholder="手机号"
               placeholder-class="auth-placeholder" value="{{phone}}" bindinput="onPhone" />
      </view>
      <view class="auth-field">
        <icon name="lock" size="36" color="var(--text-hint)" />
        <input class="auth-input" placeholder="设置密码" placeholder-class="auth-placeholder"
               password="{{!show}}" value="{{pwd}}" bindinput="onPwd" />
        <view class="auth-eye" bindtap="toggleEye">
          <icon name="eye" size="36" color="var(--text-hint)" />
        </view>
      </view>
      <view class="auth-strength">
        <view wx:for="{{[0,1,2,3]}}" wx:key="*this"
              class="auth-strength-bar {{strength > index ? bars[strength-1] : 'auth-bar-empty'}}"></view>
      </view>
      <view class="auth-field">
        <icon name="lock" size="36" color="var(--text-hint)" />
        <input class="auth-input" placeholder="再次输入密码" placeholder-class="auth-placeholder"
               password="{{!show}}" value="{{confirm}}" bindinput="onConfirm" />
      </view>
      <button class="btn btn-primary auth-cta" bindtap="submit">注册并登录</button>
    </view>
  </view>
</view>
