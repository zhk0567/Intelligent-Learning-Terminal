.page-root { min-height: 100vh; background: var(--bg-primary); padding-bottom: 120rpx; }
.story-hero { width: 100%; }
.story-detail-body { padding: 24rpx 32rpx 32rpx; }
.story-detail-title {
  font-size: 38rpx;
  font-weight: 700;
  color: var(--text-primary);
}
.story-detail-meta {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: var(--text-hint);
}
.story-detail-tags {
  margin-top: 12rpx;
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
}
.story-tag {
  border: 1rpx solid rgba(165,124,44,0.5);
  color: var(--ancient-bronze);
  border-radius: 9999rpx;
  font-size: 20rpx;
  padding: 4rpx 16rpx;
}
.story-detail-text {
  margin-top: 24rpx;
  font-size: 28rpx;
  line-height: 1.8;
  color: var(--text-primary);
  white-space: pre-line;
}
.story-detail-prose { margin-top: 28rpx; }

.story-input-bar {
  position: fixed;
  bottom: 0; left: 0; right: 0;
  z-index: 30;
  padding: 16rpx 24rpx calc(env(safe-area-inset-bottom) + 16rpx);
  background: var(--bg-card);
  border-top: 1rpx solid var(--divider-color);
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 80rpx;
}
.story-input-action {
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
