.page-root { min-height: 100vh; background: var(--bg-primary); }
.addr-add { display: flex; align-items: center; gap: 8rpx; color: var(--ancient-cinnabar); font-size: 26rpx; font-weight: 600; padding: 0 16rpx; }

.addr-list { padding: 16rpx 24rpx; display: flex; flex-direction: column; gap: 16rpx; }

.addr-card {
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
  padding: 24rpx;
  background: var(--bg-card);
  border: 1rpx solid var(--divider-color);
  border-radius: 22rpx;
}
.pin { margin-top: 4rpx; }
.addr-info { flex: 1; min-width: 0; }
.addr-row { display: flex; align-items: center; gap: 12rpx; }
.addr-name { font-size: 26rpx; font-weight: 600; color: var(--text-primary); }
.addr-phone { font-size: 22rpx; color: var(--text-secondary); }
.addr-tag {
  border: 1rpx solid rgba(183,56,46,0.4);
  background: rgba(183,56,46,0.1);
  color: var(--ancient-cinnabar);
  font-size: 18rpx;
  padding: 2rpx 10rpx;
  border-radius: 6rpx;
}
.addr-detail { margin-top: 8rpx; font-size: 22rpx; color: var(--text-secondary); }
.addr-actions { margin-top: 16rpx; display: flex; gap: 24rpx; }
.addr-act {
  display: inline-flex;
  align-items: center;
  gap: 4rpx;
  font-size: 20rpx;
  color: var(--text-hint);
}
.addr-act.default { color: var(--ancient-cinnabar); font-weight: 600; }

.form { display: flex; flex-direction: column; gap: 24rpx; }
.form-label { font-size: 22rpx; color: var(--text-secondary); margin-bottom: 8rpx; }
.form-input {
  width: 100%;
  background: rgba(212,212,212,0.08);
  border: 1rpx solid var(--divider-color);
  border-radius: 18rpx;
  padding: 18rpx 24rpx;
  font-size: 26rpx;
  color: var(--text-primary);
}
.form-area { min-height: 120rpx; }

.form-checkbox { display: flex; align-items: center; gap: 12rpx; font-size: 26rpx; color: var(--text-primary); }
.check {
  width: 32rpx; height: 32rpx;
  border-radius: 9999rpx;
  border: 4rpx solid var(--border-color);
}
.check.on { background: var(--ancient-cinnabar); border-color: var(--ancient-cinnabar); }

.form-submit { width: 100%; padding: 20rpx 0; border-radius: 9999rpx; }
