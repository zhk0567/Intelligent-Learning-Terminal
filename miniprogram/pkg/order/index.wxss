.page-root { min-height: 100vh; background: var(--bg-primary); padding-bottom: 200rpx; }
.order-body { padding: 16rpx 24rpx; display: flex; flex-direction: column; gap: 16rpx; }

.addr-card {
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
  padding: 24rpx;
  background: var(--bg-card);
  border: 1rpx solid var(--divider-color);
  border-radius: 22rpx;
}
.addr-pin { margin-top: 4rpx; }
.addr-info { flex: 1; min-width: 0; }
.addr-name { display: flex; align-items: center; gap: 12rpx; }
.addr-text { font-size: 26rpx; font-weight: 600; color: var(--text-primary); }
.addr-phone { font-size: 22rpx; color: var(--text-secondary); }
.addr-tag {
  border: 1rpx solid rgba(183,56,46,0.4);
  background: rgba(183,56,46,0.1);
  color: var(--ancient-cinnabar);
  font-size: 18rpx;
  padding: 2rpx 10rpx;
  border-radius: 6rpx;
}
.addr-detail { margin-top: 6rpx; font-size: 22rpx; color: var(--text-secondary); }
.addr-arrow { color: var(--text-hint); font-size: 32rpx; }

.order-card {
  padding: 24rpx;
  background: var(--bg-card);
  border: 1rpx solid var(--divider-color);
  border-radius: 22rpx;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.order-item {
  display: flex;
  gap: 16rpx;
  align-items: flex-start;
}
.order-cover { width: 120rpx; height: 120rpx; flex-shrink: 0; }
.order-item-info { flex: 1; min-width: 0; }
.order-item-name {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--text-primary);
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}
.order-item-spec {
  font-size: 22rpx;
  color: var(--text-hint);
  margin-top: 4rpx;
}
.order-item-bottom {
  margin-top: 8rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
}
.order-item-price { color: var(--ancient-cinnabar); font-weight: 700; font-size: 28rpx; }
.order-item-count { font-size: 22rpx; color: var(--text-hint); }

.row-line { display: flex; justify-content: space-between; }
.row-label { font-size: 22rpx; color: var(--text-secondary); }
.row-value { font-size: 24rpx; color: var(--text-primary); }

.order-card-head { display: flex; align-items: center; }
.order-card-title { font-size: 26rpx; font-weight: 700; color: var(--text-primary); }

.pay-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 16rpx 0;
}
.pay-icon {
  width: 56rpx;
  height: 56rpx;
  border-radius: 9999rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #ffffff;
  font-size: 22rpx;
  font-weight: 700;
}
.pay-label { flex: 1; font-size: 26rpx; color: var(--text-primary); }
.check {
  width: 36rpx; height: 36rpx;
  border-radius: 9999rpx;
  border: 4rpx solid var(--border-color);
}
.check.on {
  background: var(--ancient-cinnabar);
  border-color: var(--ancient-cinnabar);
}

.order-bar {
  position: fixed; bottom: 0; left: 0; right: 0; z-index: 30;
  padding: 16rpx 24rpx calc(env(safe-area-inset-bottom) + 16rpx);
  background: var(--bg-card);
  border-top: 1rpx solid var(--divider-color);
  display: flex;
  align-items: center;
  gap: 16rpx;
}
.order-bar-total { flex: 1; font-size: 26rpx; color: var(--text-primary); }
.order-bar-num { color: var(--ancient-cinnabar); font-weight: 700; font-size: 36rpx; }
.order-cta { padding: 16rpx 40rpx; }
