<view class="page-root {{__themeClass}}">
  <top-bar title="手机验证码登录"></top-bar>
  <view class="auth-body">
    <view class="auth-card">
      <view class="auth-field">
        <icon name="phone" size="36" color="var(--text-hint)" />
        <input class="auth-input" type="number" maxlength="11"
               placeholder="11 位手机号" placeholder-class="auth-placeholder"
               value="{{phone}}" bindinput="onPhone" />
      </view>
      <view class="auth-field">
        <input class="auth-input" type="number" maxlength="6"
               placeholder="验证码（演示请填 123456）" placeholder-class="auth-placeholder"
               value="{{code}}" bindinput="onCode" />
        <view class="auth-link {{seconds > 0 ? 'disabled' : ''}}" bindtap="sendCode">
          {{seconds > 0 ? seconds + 's 后重发' : '获取验证码'}}
        </view>
      </view>
      <button class="btn btn-primary auth-cta" bindtap="submit">登录</button>
      <view class="auth-foot">
        登录即代表同意
        <text class="auth-strong" bindtap="goAgreement">《用户协议》</text>
        与
        <text class="auth-strong" bindtap="goPrivacy">《隐私政策》</text>
      </view>
    </view>
  </view>
</view>
