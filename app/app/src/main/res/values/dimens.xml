    <!-- ==================== DOCUMENTATION ==================== -->

    <!-- 
        Usage Guidelines:
        
        1. Spacing: Always use the spacing_* dimensions for margins and padding
        2. Cards: Use card_* dimensions for all card-based components
        3. Buttons: Use button_* dimensions for all button types
        4. Icons: Use icon_size_* dimensions for all icons
        5. Responsive: Use responsive_* dimensions for adaptive layouts
        6. Accessibility: Use accessible_* dimensions for accessibility support
        
        Example Usage:
        
        <Button
            android:layout_width="wrap_content"
            android:layout_height="@dimen/button_min_height_medium"
            android:minWidth="@dimen/button_min_width_medium"
            android:paddingHorizontal="@dimen/button_padding_horizontal_medium"
            android:paddingVertical="@dimen/button_padding_vertical_medium" />
        
        <ImageView
            android:layout_width="@dimen/icon_size_medium"
            android:layout_height="@dimen/icon_size_medium" />
    -->

