    <!-- 
        Ancient Tech Dimension System
        =============================
        
        This file defines the dimension system for the Ancient Tech UI Enhancement.
        All dimensions follow an 8dp grid system for consistent spacing and layout.
        
        Key Principles:
        1. 8dp Grid System: All spacing uses multiples of 8dp
        2. Responsive Design: Dimensions adapt to different screen sizes
        3. Accessibility: Support for text scaling and large touch targets
        4. Consistency: Uniform dimensions across all UI components
    -->

    <!-- ==================== SPACING SYSTEM (8DP GRID) ==================== -->

    <!-- 
        Spacing System
        Based on 8dp grid system for consistent spacing throughout the app.
        All margins, paddings, and gaps should use these values.
    -->

    <!-- Ultra Small Spacing (4dp) - For tight spaces and fine adjustments -->
    <dimen name="spacing_ultra_small">4dp</dimen>

    <!-- Small Spacing (8dp) - Default spacing between related elements -->
    <dimen name="spacing_small">8dp</dimen>

    <!-- 搜索页：框内一行略下移，修正 hint/正文相对圆角框视觉偏上 -->
    <dimen name="search_bar_row_nudge_y">0dp</dimen>

    <!-- 故事页瀑布流：列间距（行间距由 item 的 marginBottom 承担） -->
    <dimen name="story_grid_column_gap">10dp</dimen>
    <dimen name="story_grid_row_gap">0dp</dimen>

    <!-- 故事详情：头图相框与正文左右对齐 -->
    <dimen name="story_detail_page_gutter">16dp</dimen>
    <!-- 内容区已在状态栏之下时，仅需与顶边留出少量间距 -->
    <dimen name="story_detail_hero_frame_margin_top">12dp</dimen>
    <dimen name="story_detail_hero_frame_margin_bottom">12dp</dimen>
    <dimen name="story_detail_hero_corner">20dp</dimen>

    <!-- 自适应桌面图标前景留白；略小以容纳「古韵薪传」整图主体 -->
    <dimen name="launcher_adaptive_logo_inset">14dp</dimen>

    <!-- Medium Spacing (16dp) - Standard spacing between sections -->
    <dimen name="spacing_medium">16dp</dimen>

    <!-- Large Spacing (24dp) - Major spacing between distinct sections -->
    <dimen name="spacing_large">24dp</dimen>

    <!-- Extra Large Spacing (32dp) - Maximum spacing for visual separation -->
    <dimen name="spacing_xlarge">32dp</dimen>

    <!-- Screen Edge Margins -->
    <dimen name="margin_screen_edge">16dp</dimen>
    <dimen name="margin_screen_edge_large">24dp</dimen>

    <!-- Content Padding -->
    <dimen name="padding_content">16dp</dimen>
    <dimen name="padding_content_small">8dp</dimen>
    <dimen name="padding_content_large">24dp</dimen>

    <!-- List Item Spacing -->
    <dimen name="spacing_list_item">8dp</dimen>
    <dimen name="spacing_list_section">16dp</dimen>

    <!-- Grid Spacing -->
    <dimen name="spacing_grid_horizontal">8dp</dimen>
    <dimen name="spacing_grid_vertical">8dp</dimen>

