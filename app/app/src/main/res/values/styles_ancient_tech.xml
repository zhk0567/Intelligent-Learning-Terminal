<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- 古风科技文本样式 -->
    
    <!-- Title 基础样式 -->
    <style name="TextAppearance.AncientTech.Title">
        <item name="android:textSize">20sp</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textStyle">bold</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:letterSpacing">0.02</item>
    </style>
    
    <style name="TextAppearance.AncientTech.Title.Large">
        <item name="android:textSize">28sp</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textStyle">bold</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:letterSpacing">0.02</item>
        <item name="android:lineSpacingMultiplier">1.1</item>
    </style>

    <style name="TextAppearance.AncientTech.Title.Medium">
        <item name="android:textSize">22sp</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textStyle">bold</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:letterSpacing">0.02</item>
        <item name="android:lineSpacingMultiplier">1.1</item>
    </style>

    <style name="TextAppearance.AncientTech.Title.Small">
        <item name="android:textSize">18sp</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textStyle">bold</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:letterSpacing">0.02</item>
    </style>

    <style name="TextAppearance.AncientTech.Body.Large">
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:lineSpacingMultiplier">1.6</item>
    </style>

    <style name="TextAppearance.AncientTech.Body.Medium">
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:lineSpacingMultiplier">1.5</item>
    </style>

    <style name="TextAppearance.AncientTech.Body.Small">
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">@color/text_hint</item>
        <item name="android:lineSpacingMultiplier">1.4</item>
    </style>

    <!-- 霓虹效果文本 -->
    <style name="TextAppearance.AncientTech.Neon">
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">@color/neon_cyan</item>
        <item name="android:textStyle">bold</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:shadowColor">@color/neon_cyan</item>
        <item name="android:shadowDx">0</item>
        <item name="android:shadowDy">0</item>
        <item name="android:shadowRadius">8</item>
    </style>

    <!-- 按钮样式 -->
    <style name="Widget.AncientTech.Button.Primary">
        <item name="android:textSize">15sp</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textStyle">bold</item>
        <item name="android:background">@drawable/btn_ancient_tech</item>
        <item name="android:paddingHorizontal">24dp</item>
        <item name="android:paddingVertical">12dp</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:minWidth">120dp</item>
    </style>

    <style name="Widget.AncientTech.Button.Secondary">
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/neon_cyan</item>
        <item name="android:textStyle">bold</item>
        <item name="android:background">@drawable/btn_ancient_tech</item>
        <item name="android:paddingHorizontal">20dp</item>
        <item name="android:paddingVertical">10dp</item>
        <item name="android:minHeight">44dp</item>
        <item name="android:minWidth">100dp</item>
    </style>

    <!-- 卡片样式 -->
    <style name="Widget.AncientTech.Card">
        <item name="android:background">@drawable/card_bg_ancient_tech</item>
        <item name="android:padding">16dp</item>
        <item name="android:elevation">8dp</item>
    </style>

    <!-- 标签样式 -->
    <style name="Widget.AncientTech.Tag.Primary">
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textStyle">bold</item>
        <item name="android:background">@drawable/tag_bg_ancient_selected</item>
        <item name="android:paddingHorizontal">12dp</item>
        <item name="android:paddingVertical">6dp</item>
    </style>

    <style name="Widget.AncientTech.Tag.Secondary">
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:textStyle">bold</item>
        <item name="android:background">@drawable/tag_bg_ancient_normal</item>
        <item name="android:paddingHorizontal">12dp</item>
        <item name="android:paddingVertical">6dp</item>
    </style>
</resources>
