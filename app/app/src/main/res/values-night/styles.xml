    </style>
    
    <!-- Caption: Adjusted for dark theme -->
    <style name="TextAppearance.AncientTech.Caption">
        <item name="android:textColor">@color/text_hint</item>
        <!-- Other properties inherited from base -->
    </style>
    
    <!-- ==================== BUTTONS ==================== -->
    
    <!-- Button: Adjusted for dark theme -->
