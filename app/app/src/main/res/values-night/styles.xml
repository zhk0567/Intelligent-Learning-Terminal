        <!-- Other properties inherited from base -->
    </style>
    
    <!-- ButtonSmall: Adjusted for dark theme -->
    <style name="TextAppearance.AncientTech.ButtonSmall">
        <item name="android:textColor">@color/text_primary</item>
        <!-- Other properties inherited from base -->
    </style>
    
