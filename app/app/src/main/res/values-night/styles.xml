    <!-- Link: Adjusted for dark theme - brighter for dark background -->
    <style name="TextAppearance.AncientTech.Link">
        <item name="android:textColor">@color/neon_cyan</item>
        <!-- Other properties inherited from base -->
    </style>
    
    <!-- ==================== CARD SPECIFIC TEXT ==================== -->
    
    <!-- CardTitle: Adjusted for dark theme -->
