<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    
    <!-- 
        Ancient Tech Typography System - Night/Dark Theme
        ================================================
        
        This file defines the typography styles for the Ancient Tech UI Enhancement
        in dark/night mode. Text colors are adjusted for better contrast and
        readability in dark environments.
        
        Note: Most text styles inherit from the base styles.xml in values directory.
        Only override items that need to change for dark theme.
    -->
    
    <!-- ==================== HEADINGS ==================== -->
    
    <!-- Heading 1: Adjusted for dark theme -->
    <style name="TextAppearance.AncientTech.Heading1">
        <item name="android:textColor">@color/text_primary</item>
        <!-- Other properties inherited from base -->
    </style>
    
    <!-- Heading 2: Adjusted for dark theme -->
    <style name="TextAppearance.AncientTech.Heading2">
        <item name="android:textColor">@color/text_primary</item>
        <!-- Other properties inherited from base -->
    </style>
    
    <!-- Heading 3: Adjusted for dark theme -->
    <style name="TextAppearance.AncientTech.Heading3">
        <item name="android:textColor">@color/text_primary</item>
        <!-- Other properties inherited from base -->
    </style>
    
    <!-- ==================== BODY TEXT ==================== -->
    
    <!-- Body: Adjusted for dark theme -->
    <style name="TextAppearance.AncientTech.Body">
        <item name="android:textColor">@color/text_primary</item>
        <!-- Other properties inherited from base -->
    </style>
    
    <!-- BodySmall: Adjusted for dark theme -->
    <style name="TextAppearance.AncientTech.BodySmall">
        <item name="android:textColor">@color/text_secondary</item>
        <!-- Other properties inherited from base -->
    </style>
    
    <!-- ==================== LABELS ==================== -->
    
