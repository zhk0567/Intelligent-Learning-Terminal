<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/shopPageRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_primary"
    android:fitsSystemWindows="false"
    android:orientation="vertical">

    <!-- wrap_content + 内层 56dp：配合 MallWindowInsets 顶栏 paddingTop = 状态栏高度 -->
    <FrameLayout
        android:id="@+id/shopTopInsetHost"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/mall_header_bar_bg"
        android:elevation="2dp">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="56dp">

            <TextView
                android:id="@+id/shopTitleText"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:text="商城"
                android:textColor="@color/neon_teal"
                android:textSize="18sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_gravity="center_vertical|end"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingEnd="8dp">

                <FrameLayout
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_marginEnd="4dp">

                    <ImageButton
                        android:id="@+id/addressButton"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:layout_gravity="center"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="收货地址"
                        android:padding="8dp"
                        android:scaleType="fitCenter"
                        android:src="@drawable/ic_shop_scroll_address" />
                </FrameLayout>

                <FrameLayout
                    android:layout_width="48dp"
                    android:layout_height="48dp">

                    <ImageButton
                        android:id="@+id/cartButton"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:layout_gravity="center"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="购物车"
                        android:padding="8dp"
                        android:scaleType="fitCenter"
                        android:src="@drawable/ic_shop_basket_cart" />

                    <TextView
                        android:id="@+id/cartBadge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="top|end"
                        android:background="@drawable/shop_cart_badge_bg"
                        android:gravity="center"
                        android:minWidth="18dp"
                        android:paddingHorizontal="5dp"
                        android:paddingVertical="1dp"
                        android:textColor="@color/white"
                        android:textSize="10sp"
                        android:visibility="gone"
                        tools:text="3"
                        tools:visibility="visible" />
                </FrameLayout>
            </LinearLayout>
        </FrameLayout>
    </FrameLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@color/bg_primary">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/productRecyclerView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/bg_primary"
            android:clipToPadding="false"
            android:overScrollMode="never"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:paddingBottom="8dp"
            tools:listitem="@layout/item_shop_product" />

        <FrameLayout
            android:id="@+id/shopSkeletonOverlay"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clickable="true"
            android:focusable="true"
            android:visibility="gone">

            <include layout="@layout/shop_skeleton_overlay" />
        </FrameLayout>
    </FrameLayout>

    <include layout="@layout/bottom_navigation" />
</LinearLayout>
