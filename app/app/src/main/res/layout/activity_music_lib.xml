<?xml version="1.0" encoding="utf-8"?>
<!--
    整体：深色国风背景，青绿色强调色
-->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/music_lib_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg_primary"
    android:fitsSystemWindows="false">

    <ScrollView
        android:id="@+id/scrollView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:overScrollMode="never">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="16dp"
            android:paddingTop="0dp"
            android:paddingBottom="12dp">

            <!-- ── 搜索栏 ── -->
            <LinearLayout
                android:id="@+id/search_bar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/search_bar_bg"
                android:paddingHorizontal="16dp"
                android:paddingVertical="12dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:layout_marginTop="10dp"
                android:layout_marginBottom="16dp"
                android:elevation="4dp"
                android:clickable="true"
                android:focusable="true">
                <!-- 放大镜图标（线条风，青绿色） -->
                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:src="@drawable/ic_search"
                    android:scaleType="fitCenter"
                    app:tint="@color/search_bar_icon_tint"
                    android:contentDescription="@string/search_hint" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="搜索音乐、乐器、故事..."
                    android:textColor="@color/text_secondary"
                    android:textSize="15sp"
                    android:layout_marginStart="10dp" />
            </LinearLayout>

            <!-- ── 轮播图 ── -->
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <androidx.viewpager2.widget.ViewPager2
                    android:id="@+id/banner_viewpager"
                    android:layout_width="match_parent"
                    android:layout_height="180dp" />

                <!-- 圆点指示器 -->
                <LinearLayout
                    android:id="@+id/dot_layout"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentBottom="true"
                    android:layout_centerHorizontal="true"
                    android:layout_marginBottom="12dp"
                    android:orientation="horizontal"
                    android:background="@android:color/transparent"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="6dp">

                    <View
                        android:id="@+id/dot1"
                        android:layout_width="8dp"
                        android:layout_height="8dp"
                        android:background="@drawable/dot_selected_bg"
                        android:layout_margin="3dp" />

                    <View
                        android:id="@+id/dot2"
                        android:layout_width="8dp"
                        android:layout_height="8dp"
                        android:background="@drawable/dot_normal_bg"
                        android:layout_margin="3dp" />

                    <View
                        android:id="@+id/dot3"
                        android:layout_width="8dp"
                        android:layout_height="8dp"
                        android:background="@drawable/dot_normal_bg"
                        android:layout_margin="3dp" />
                </LinearLayout>
            </RelativeLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/home_section_outline_bg"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:paddingTop="12dp"
                android:paddingBottom="12dp"
                android:layout_marginTop="16dp">

            <!-- ── 每日热门：标题行 ── -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="每日热门"
                android:textColor="@color/text_primary"
                android:textSize="17sp"
                android:textStyle="bold"
                android:layout_marginTop="0dp" />

            <!-- 热门图标行：4个等宽方块 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="10dp">

                <!-- 热门1 -->
                <LinearLayout
                    android:id="@+id/hot1"
                    android:layout_width="0dp"
                    android:layout_height="72dp"
                    android:layout_weight="1"
                    android:background="@drawable/hot_icon_bg"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:clickable="true"
                    android:focusable="true">

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/ic_heritage_music"
                        app:tint="@color/neon_cyan_light"
                        android:contentDescription="非遗音乐" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="非遗音乐"
                        android:textSize="11sp"
                        android:textColor="@color/text_secondary"
                        android:layout_marginTop="4dp"
                        android:fontFamily="sans-serif" />
                </LinearLayout>

                <!-- 热门2 -->
                <LinearLayout
                    android:id="@+id/hot2"
                    android:layout_width="0dp"
                    android:layout_height="72dp"
                    android:layout_weight="1"
                    android:background="@drawable/hot_icon_bg"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:layout_marginStart="10dp"
                    android:clickable="true"
                    android:focusable="true">

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/ic_traditional_instrument"
                        app:tint="@color/neon_cyan_light"
                        android:contentDescription="传统乐器" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="传统乐器"
                        android:textSize="11sp"
                        android:textColor="@color/text_secondary"
                        android:layout_marginTop="4dp"
                        android:fontFamily="sans-serif" />
                </LinearLayout>

                <!-- 热门3 -->
                <LinearLayout
                    android:id="@+id/hot3"
                    android:layout_width="0dp"
                    android:layout_height="72dp"
                    android:layout_weight="1"
                    android:background="@drawable/hot_icon_bg"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:layout_marginStart="10dp"
                    android:clickable="true"
                    android:focusable="true">

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/ic_classic_track"
                        app:tint="@color/neon_cyan_light"
                        android:contentDescription="经典曲目" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="经典曲目"
                        android:textSize="11sp"
                        android:textColor="@color/text_secondary"
                        android:layout_marginTop="4dp"
                        android:fontFamily="sans-serif" />
                </LinearLayout>

                <!-- 热门4 -->
                <LinearLayout
                    android:id="@+id/hot4"
                    android:layout_width="0dp"
                    android:layout_height="72dp"
                    android:layout_weight="1"
                    android:background="@drawable/hot_icon_bg"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:layout_marginStart="10dp"
                    android:clickable="true"
                    android:focusable="true">

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/ic_music_score"
                        app:tint="@color/neon_cyan_light"
                        android:contentDescription="乐谱赏析" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="乐谱赏析"
                        android:textSize="11sp"
                        android:textColor="@color/text_secondary"
                        android:layout_marginTop="4dp"
                        android:fontFamily="sans-serif" />
                </LinearLayout>
            </LinearLayout>

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/home_section_outline_bg"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:paddingTop="12dp"
                android:paddingBottom="12dp"
                android:layout_marginTop="12dp">

            <!-- ── 每日精选：标题行 + 查看更多 ── -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="0dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="每日精选"
                    android:textColor="@color/text_primary"
                    android:textSize="17sp"
                    android:textStyle="bold"
                    android:fontFamily="sans-serif" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1" />
                <!-- 查看更多按钮：文字小箭头 -->
                <TextView
                    android:id="@+id/arrow_select"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="查看更多 ›"
                    android:textColor="@color/neon_cyan_light"
                    android:textSize="13sp"
                    android:paddingVertical="4dp"
                    android:clickable="true"
                    android:focusable="true" />
            </LinearLayout>

            <!-- 精选卡片：3张 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="12dp">

                <!-- 卡片1 -->
                <LinearLayout
                    android:id="@+id/select1"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="@drawable/select_card_bg"
                    android:orientation="vertical"
                    android:padding="8dp"
                    android:clickable="true"
                    android:focusable="true">

                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="130dp">

                        <com.google.android.material.imageview.ShapeableImageView
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:src="@drawable/banner1_img"
                            android:scaleType="centerCrop"
                            android:contentDescription="雅韵国风"
                            app:shapeAppearanceOverlay="@style/ShapeImageRounded12" />

                        <ImageView
                            android:layout_width="28dp"
                            android:layout_height="28dp"
                            android:src="@drawable/ic_mini_play"
                            android:layout_gravity="bottom|end"
                            android:layout_margin="4dp"
                            app:tint="@color/neon_cyan_light"
                            android:contentDescription="播放" />
                    </FrameLayout>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="东方乐器的回响"
                        android:textColor="@color/text_primary"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:maxLines="1"
                        android:ellipsize="end"
                        android:layout_marginTop="8dp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="传统乐器经典"
                        android:textColor="@color/text_hint"
                        android:textSize="12sp"
                        android:maxLines="1"
                        android:ellipsize="end"
                        android:layout_marginTop="4dp" />
                </LinearLayout>

                <!-- 卡片2 -->
                <LinearLayout
                    android:id="@+id/select2"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="@drawable/select_card_bg"
                    android:orientation="vertical"
                    android:padding="8dp"
                    android:layout_marginStart="10dp"
                    android:clickable="true"
                    android:focusable="true">

                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="130dp">

                        <com.google.android.material.imageview.ShapeableImageView
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:src="@drawable/banner2_img"
                            android:scaleType="centerCrop"
                            android:contentDescription="雅韵"
                            app:shapeAppearanceOverlay="@style/ShapeImageRounded12" />

                        <ImageView
                            android:layout_width="28dp"
                            android:layout_height="28dp"
                            android:src="@drawable/ic_mini_play"
                            android:layout_gravity="bottom|end"
                            android:layout_margin="4dp"
                            app:tint="@color/neon_cyan_light"
                            android:contentDescription="播放" />
                    </FrameLayout>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="绘壁遗韵"
                        android:textColor="@color/text_primary"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:maxLines="1"
                        android:ellipsize="end"
                        android:layout_marginTop="8dp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="壁画音乐故事"
                        android:textColor="@color/text_hint"
                        android:textSize="12sp"
                        android:maxLines="1"
                        android:ellipsize="end"
                        android:layout_marginTop="4dp" />
                </LinearLayout>

                <!-- 卡片3 -->
                <LinearLayout
                    android:id="@+id/select3"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="@drawable/select_card_bg"
                    android:orientation="vertical"
                    android:padding="8dp"
                    android:layout_marginStart="10dp"
                    android:clickable="true"
                    android:focusable="true">

                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="130dp">

                        <com.google.android.material.imageview.ShapeableImageView
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:src="@drawable/banner3_img"
                            android:scaleType="centerCrop"
                            android:contentDescription="弦韵中华"
                            app:shapeAppearanceOverlay="@style/ShapeImageRounded12" />

                        <ImageView
                            android:layout_width="28dp"
                            android:layout_height="28dp"
                            android:src="@drawable/ic_mini_play"
                            android:layout_gravity="bottom|end"
                            android:layout_margin="4dp"
                            app:tint="@color/neon_cyan_light"
                            android:contentDescription="播放" />
                    </FrameLayout>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="仕女弄乐图"
                        android:textColor="@color/text_primary"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:maxLines="1"
                        android:ellipsize="end"
                        android:layout_marginTop="8dp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="民族乐器演奏"
                        android:textColor="@color/text_hint"
                        android:textSize="12sp"
                        android:maxLines="1"
                        android:ellipsize="end"
                        android:layout_marginTop="4dp" />
                </LinearLayout>
            </LinearLayout>

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/home_section_outline_bg"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:paddingTop="12dp"
                android:paddingBottom="12dp"
                android:layout_marginTop="12dp">

            <!-- ── 猜你喜欢：标题行 + 查看更多 ── -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="0dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="猜你喜欢"
                    android:textColor="@color/text_primary"
                    android:textSize="17sp"
                    android:textStyle="bold"
                    android:fontFamily="sans-serif" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1" />

                <TextView
                    android:id="@+id/arrow_like"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="查看更多 ›"
                    android:textColor="@color/neon_cyan_light"
                    android:textSize="13sp"
                    android:paddingVertical="4dp"
                    android:clickable="true"
                    android:focusable="true" />
            </LinearLayout>

            <!-- 分类标签行 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="12dp">

                <TextView
                    android:id="@+id/tag1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="民俗节庆"
                    android:textColor="@color/text_secondary"
                    android:textSize="13sp"
                    android:background="@drawable/tag_bg_normal"
                    android:paddingHorizontal="14dp"
                    android:paddingVertical="7dp"
                    android:layout_marginEnd="8dp"
                    android:clickable="true"
                    android:focusable="true" />

                <TextView
                    android:id="@+id/tag2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="非遗跨界"
                    android:textColor="@color/text_primary"
                    android:textSize="13sp"
                    android:background="@drawable/tag_bg_selected"
                    android:paddingHorizontal="14dp"
                    android:paddingVertical="7dp"
                    android:layout_marginEnd="8dp"
                    android:clickable="true"
                    android:focusable="true" />

                <TextView
                    android:id="@+id/tag3"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="小众跨界"
                    android:textColor="@color/text_secondary"
                    android:textSize="13sp"
                    android:background="@drawable/tag_bg_normal"
                    android:paddingHorizontal="14dp"
                    android:paddingVertical="7dp"
                    android:clickable="true"
                    android:focusable="true" />
            </LinearLayout>

            <!-- 标签内容区 -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp">

                <!-- 民俗节庆内容 -->
                <LinearLayout
                    android:id="@+id/content_tag1"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <LinearLayout
                        android:id="@+id/list1_item1"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/music_list_item_bg"
                        android:padding="14dp"
                        android:gravity="center_vertical"
                        android:clickable="true"
                        android:focusable="true">

                        <ImageView
                            android:layout_width="52dp"
                            android:layout_height="52dp"
                            android:src="@drawable/banner1_img"
                            android:scaleType="centerCrop"
                            android:background="@drawable/music_icon_thumb_bg"
                            android:contentDescription="元宵灯会" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:layout_marginStart="12dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="元宵灯会"
                                android:textColor="@color/text_primary"
                                android:textSize="15sp"
                                android:textStyle="bold"
                                android:fontFamily="sans-serif" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="传统民俗音乐"
                                android:textColor="@color/text_hint"
                                android:textSize="12sp"
                                android:layout_marginTop="3dp" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>

                <!-- 非遗跨界内容 -->
                <LinearLayout
                    android:id="@+id/content_tag2"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <LinearLayout
                        android:id="@+id/list2_item1"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/music_list_item_bg"
                        android:padding="14dp"
                        android:gravity="center_vertical"
                        android:clickable="true"
                        android:focusable="true">

                        <ImageView
                            android:layout_width="52dp"
                            android:layout_height="52dp"
                            android:src="@drawable/banner2_img"
                            android:scaleType="centerCrop"
                            android:background="@drawable/music_icon_thumb_bg"
                            android:contentDescription="昆曲·牡丹亭" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:layout_marginStart="12dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="昆曲・牡丹亭"
                                android:textColor="@color/text_primary"
                                android:textSize="15sp"
                                android:textStyle="bold"
                                android:fontFamily="sans-serif" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="传统戏曲经典曲目"
                                android:textColor="@color/text_hint"
                                android:textSize="12sp"
                                android:layout_marginTop="3dp" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>

                <!-- 小众跨界内容 -->
                <LinearLayout
                    android:id="@+id/content_tag3"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <LinearLayout
                        android:id="@+id/list3_item1"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/music_list_item_bg"
                        android:padding="14dp"
                        android:gravity="center_vertical"
                        android:clickable="true"
                        android:focusable="true">

                        <ImageView
                            android:layout_width="52dp"
                            android:layout_height="52dp"
                            android:src="@drawable/banner3_img"
                            android:scaleType="centerCrop"
                            android:background="@drawable/music_icon_thumb_bg"
                            android:contentDescription="古风电子 remix" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:layout_marginStart="12dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="古风电子 remix"
                                android:textColor="@color/text_primary"
                                android:textSize="15sp"
                                android:textStyle="bold"
                                android:fontFamily="sans-serif" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="非遗与现代电子乐融合"
                                android:textColor="@color/text_hint"
                                android:textSize="12sp"
                                android:layout_marginTop="3dp" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
            </FrameLayout>

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/home_section_outline_bg"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:paddingTop="12dp"
                android:paddingBottom="12dp"
                android:layout_marginTop="12dp">

            <!-- ── 基础学习：标题 ── -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="基础学习"
                android:textColor="@color/text_primary"
                android:textSize="17sp"
                android:textStyle="bold"
                android:layout_marginTop="0dp" />

            <!-- 学习条目1 -->
            <LinearLayout
                android:id="@+id/learn1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/music_list_item_bg"
                android:padding="14dp"
                android:gravity="center_vertical"
                android:layout_marginTop="12dp"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:layout_width="52dp"
                    android:layout_height="52dp"
                    android:src="@drawable/banner1_img"
                    android:scaleType="centerCrop"
                    android:background="@drawable/music_icon_thumb_bg"
                    android:contentDescription="非遗乐器入门" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_marginStart="12dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="非遗乐器入门"
                        android:textColor="@color/text_primary"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:fontFamily="sans-serif" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="从零开始的传统乐器学习"
                        android:textColor="@color/text_hint"
                        android:textSize="12sp"
                        android:layout_marginTop="3dp" />
                </LinearLayout>
            </LinearLayout>

            <!-- 学习条目2 -->
            <LinearLayout
                android:id="@+id/learn2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/music_list_item_bg"
                android:padding="14dp"
                android:gravity="center_vertical"
                android:layout_marginTop="10dp"
                android:layout_marginBottom="8dp"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:layout_width="52dp"
                    android:layout_height="52dp"
                    android:src="@drawable/banner2_img"
                    android:scaleType="centerCrop"
                    android:background="@drawable/music_icon_thumb_bg"
                    android:contentDescription="乐理基础" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_marginStart="12dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="乐理基础"
                        android:textColor="@color/text_primary"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:fontFamily="sans-serif" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="非遗音乐理论知识讲解"
                        android:textColor="@color/text_hint"
                        android:textSize="12sp"
                        android:layout_marginTop="3dp" />
                </LinearLayout>
            </LinearLayout>

            </LinearLayout>

        </LinearLayout>
    </ScrollView>

    <!-- 迷你播放器 -->
    <FrameLayout
        android:id="@+id/miniPlayerContainer"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginTop="6dp"
        android:layout_marginBottom="6dp"
        android:background="@drawable/mini_player_bg"
        android:clickable="true"
        android:focusable="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingEnd="16dp">

            <FrameLayout
                android:layout_width="52dp"
                android:layout_height="match_parent">

                <ImageView
                    android:id="@+id/miniCoverImage"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/mini_cover_bg"
                    android:padding="1dp"
                    android:scaleType="centerCrop"
                    android:src="@drawable/banner1_img"
                    android:contentDescription="当前播放音乐" />

                <View
                    android:id="@+id/miniCoverLoadingRing"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/mini_cover_loading_ring"
                    android:visibility="gone" />

                <ImageView
                    android:layout_width="12dp"
                    android:layout_height="12dp"
                    android:layout_gravity="bottom|end"
                    android:layout_marginEnd="2dp"
                    android:layout_marginBottom="2dp"
                    android:src="@drawable/ic_music_note_mini"
                    android:contentDescription="音乐标识" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="10dp"
                android:layout_marginEnd="12dp"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/miniSongTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="高山流水"
                    android:textColor="@color/text_primary"
                    android:textSize="14sp"
                    android:fontFamily="sans-serif-medium" />

                <TextView
                    android:id="@+id/miniSongArtist"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="1dp"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="古筝演奏"
                    android:textColor="@color/text_secondary"
                    android:textSize="11sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageButton
                    android:id="@+id/miniPrevButton"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:background="?android:attr/selectableItemBackgroundBorderless"
                    android:padding="0dp"
                    android:src="@drawable/ic_mini_prev"
                    app:tint="@color/player_control_tint"
                    android:contentDescription="上一首" />

                <FrameLayout
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:layout_marginStart="10dp"
                    android:layout_marginEnd="10dp">

                    <View
                        android:id="@+id/miniPlayHalo"
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:layout_gravity="center"
                        android:background="@drawable/mini_play_halo"
                        android:visibility="gone" />

                    <ImageButton
                        android:id="@+id/miniPlayPauseButton"
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:layout_gravity="center"
                        android:background="@drawable/mini_play_button_bg"
                        android:padding="10dp"
                        android:src="@drawable/ic_mini_play"
                        app:tint="@color/white"
                        android:contentDescription="播放或暂停" />
                </FrameLayout>

                <ImageButton
                    android:id="@+id/miniNextButton"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:background="?android:attr/selectableItemBackgroundBorderless"
                    android:padding="0dp"
                    android:src="@drawable/ic_mini_next"
                    app:tint="@color/player_control_tint"
                    android:contentDescription="下一首" />

                <ImageButton
                    android:id="@+id/miniPlaylistButton"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_marginStart="10dp"
                    android:background="?android:attr/selectableItemBackgroundBorderless"
                    android:padding="0dp"
                    android:src="@drawable/ic_mini_list"
                    app:tint="@color/player_control_tint"
                    android:contentDescription="播放列表" />
            </LinearLayout>
        </LinearLayout>

        <View
            android:id="@+id/miniProgressLine"
            android:layout_width="match_parent"
            android:layout_height="2dp"
            android:layout_gravity="bottom"
            android:scaleX="0"
            android:transformPivotX="0dp"
            android:background="@color/neon_teal" />
    </FrameLayout>

    <!-- 底部导航栏 -->
    <include layout="@layout/bottom_navigation"/>

</LinearLayout>
