<?xml version="1.0" encoding="utf-8"?>
<!--
    故事页主布局
    顶部：Tab 栏（推荐 / 关注）
    中间：两列瀑布流 RecyclerView
    底部：统一导航栏
-->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/story_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg_primary"
    android:fitsSystemWindows="false">

    <!-- ── 顶部 Tab 栏 ── -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:orientation="horizontal"
        android:background="@color/bg_primary"
        android:elevation="2dp">

        <!-- 推荐 Tab -->
        <TextView
            android:id="@+id/tabRecommend"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="推荐"
            android:textSize="16sp"
            android:textColor="@color/neon_cyan"
            android:textStyle="bold"
            android:gravity="center"
            android:background="@drawable/story_tab_selected"
            android:clickable="true"
            android:focusable="true"/>

        <!-- 关注 Tab -->
        <TextView
            android:id="@+id/tabFollow"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="关注"
            android:textSize="16sp"
            android:textColor="@color/text_secondary"
            android:gravity="center"
            android:background="@drawable/story_tab_unselected"
            android:clickable="true"
            android:focusable="true"/>

    </LinearLayout>

    <!-- ── 内容区：两个 RecyclerView 切换显示 ── -->
    <FrameLayout
        android:id="@+id/story_rv_container"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <!-- 推荐瀑布流，默认可见 -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recommendRecyclerView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:paddingHorizontal="12dp"
            android:paddingTop="12dp"
            android:paddingBottom="80dp"
            android:clipToPadding="false"
            android:overScrollMode="never"
            android:visibility="visible"/>

        <!-- 关注瀑布流，默认隐藏 -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/followRecyclerView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:paddingHorizontal="12dp"
            android:paddingTop="12dp"
            android:paddingBottom="80dp"
            android:clipToPadding="false"
            android:overScrollMode="never"
            android:visibility="gone"/>

    </FrameLayout>

    <!-- ── 底部导航栏 ── -->
    <include layout="@layout/bottom_navigation"/>

</LinearLayout>
