<?xml version="1.0" encoding="utf-8"?>
<!-- 搜索结果页面布局 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_primary"
    android:orientation="vertical"
    android:fitsSystemWindows="true">

    <!-- 顶部搜索栏 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="12dp"
        android:background="@color/bg_card"
        android:elevation="4dp">

        <!-- 返回按钮 -->
        <ImageView
            android:id="@+id/btn_back"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:src="@drawable/ic_back"
            app:tint="@color/neon_cyan"
            android:padding="6dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="返回" />

        <!-- 搜索框 -->
        <EditText
            android:id="@+id/search_input"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:layout_marginHorizontal="8dp"
            android:hint="搜索音乐、故事、课程..."
            android:textColor="@color/text_primary"
            android:textSize="14sp"
            android:background="@drawable/tag_bg_normal"
            android:paddingHorizontal="12dp"
            android:imeOptions="actionSearch"
            android:inputType="text"
            android:maxLines="1" />

        <!-- 搜索按钮 -->
        <TextView
            android:id="@+id/btn_search"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="搜索"
            android:textColor="@color/neon_cyan"
            android:textSize="15sp"
            android:textStyle="bold"
            android:paddingHorizontal="8dp"
            android:paddingVertical="6dp"
            android:clickable="true"
            android:focusable="true" />
    </LinearLayout>

    <!-- 搜索结果显示区 -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <!-- 空状态 -->
        <LinearLayout
            android:id="@+id/empty_state_layout"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:gravity="center"
            android:visibility="gone">

            <ImageView
                android:layout_width="120dp"
                android:layout_height="120dp"
                android:src="@drawable/ic_search"
                app:tint="@color/text_hint"
                android:alpha="0.45"
                android:contentDescription="无结果" />

            <TextView
                android:id="@+id/empty_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="暂无搜索结果"
                android:textColor="@color/text_hint"
                android:textSize="15sp"
                android:layout_marginTop="16dp" />

            <TextView
                android:id="@+id/empty_subtext"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="换个关键词试试"
                android:textColor="@color/text_hint"
                android:textSize="13sp"
                android:layout_marginTop="8dp" />
        </LinearLayout>

        <!-- 搜索结果列表 -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/result_recycler_view"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone"
            android:clipToPadding="false"
            android:padding="12dp" />

        <!-- 加载进度条 -->
        <ProgressBar
            android:id="@+id/loading_progress"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:indeterminateTint="@color/neon_cyan" />
    </FrameLayout>

</LinearLayout>
