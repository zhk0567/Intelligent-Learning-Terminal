<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_primary"
    android:fillViewport="true"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp"
        android:paddingBottom="32dp"
        android:clipToPadding="false">

        <!-- 标题栏 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="24dp">

            <ImageButton
                android:id="@+id/backButton"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:contentDescription="@string/cd_back"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_back"
                app:tint="@color/neon_teal" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="发布作品"
                android:textColor="@color/text_primary"
                android:textSize="20sp"
                android:textStyle="bold"
                android:gravity="center" />

            <TextView
                android:id="@+id/publishButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="发布"
                android:textColor="@color/neon_teal"
                android:textSize="16sp"
                android:textStyle="bold"
                android:padding="8dp"
                android:clickable="true"
                android:focusable="true"
                android:background="?android:attr/selectableItemBackground" />

        </LinearLayout>

        <!-- 表单卡片 -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="@color/bg_card"
            app:cardCornerRadius="12dp"
            app:cardElevation="4dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <!-- 上传音频 -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="上传音频 *"
                    android:textColor="@color/text_secondary"
                    android:textSize="14sp"
                    android:layout_marginBottom="8dp" />

                <LinearLayout
                    android:id="@+id/uploadAudioBtn"
                    android:layout_width="match_parent"
                    android:layout_height="80dp"
                    android:background="@drawable/edit_text_bg"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:clickable="true"
                    android:focusable="true"
                    android:layout_marginBottom="20dp">

                    <ImageView
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:src="@android:drawable/ic_input_add"
                        app:tint="@color/neon_teal" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="点击上传音频文件"
                        android:textColor="@color/input_hint_readable"
                        android:textSize="13sp"
                        android:layout_marginTop="4dp" />

                </LinearLayout>

                <!-- 作品标题 -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="作品标题 *"
                    android:textColor="@color/text_secondary"
                    android:textSize="14sp"
                    android:layout_marginBottom="8dp" />

                <EditText
                    android:id="@+id/etTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="请输入作品标题"
                    android:textColorHint="@color/input_hint_readable"
                    android:textColor="@color/text_primary"
                    android:textSize="16sp"
                    android:background="@drawable/edit_text_bg"
                    android:padding="12dp"
                    android:layout_marginBottom="20dp"
                    android:maxLines="1" />

                <!-- 作品介绍 -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="作品介绍 *"
                    android:textColor="@color/text_secondary"
                    android:textSize="14sp"
                    android:layout_marginBottom="8dp" />

                <EditText
                    android:id="@+id/etDescription"
                    android:layout_width="match_parent"
                    android:layout_height="120dp"
                    android:hint="介绍你的创作灵感和背景..."
                    android:textColorHint="@color/input_hint_readable"
                    android:textColor="@color/text_primary"
                    android:textSize="16sp"
                    android:background="@drawable/edit_text_bg"
                    android:padding="12dp"
                    android:gravity="top|start"
                    android:inputType="textMultiLine"
                    android:layout_marginBottom="20dp" />

                <!-- BPM (每分钟节拍数) -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="BPM (选填)"
                    android:textColor="@color/text_secondary"
                    android:textSize="14sp"
                    android:layout_marginBottom="8dp" />

                <EditText
                    android:id="@+id/etBpm"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="例如: 120"
                    android:textColorHint="@color/input_hint_readable"
                    android:textColor="@color/text_primary"
                    android:textSize="16sp"
                    android:background="@drawable/edit_text_bg"
                    android:padding="12dp"
                    android:inputType="number"
                    android:layout_marginBottom="20dp"
                    android:maxLines="1" />

                <!-- 使用乐器 -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="使用乐器 (选填)"
                    android:textColor="@color/text_secondary"
                    android:textSize="14sp"
                    android:layout_marginBottom="8dp" />

                <EditText
                    android:id="@+id/etInstruments"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="例如: 古筝、二胡、钢琴"
                    android:textColorHint="@color/input_hint_readable"
                    android:textColor="@color/text_primary"
                    android:textSize="16sp"
                    android:background="@drawable/edit_text_bg"
                    android:padding="12dp"
                    android:layout_marginBottom="20dp"
                    android:maxLines="1" />

                <!-- 标签选择 -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="作品标签 (多选)"
                    android:textColor="@color/text_secondary"
                    android:textSize="14sp"
                    android:layout_marginBottom="12dp" />

                <HorizontalScrollView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:scrollbars="none">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/tagTraditional"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="传统"
                            android:textColor="@color/shop_text_muted"
                            android:textSize="13sp"
                            android:background="@drawable/create_tag_normal"
                            android:paddingHorizontal="14dp"
                            android:paddingVertical="7dp"
                            android:layout_marginEnd="8dp"
                            android:clickable="true"
                            android:focusable="true" />

                        <TextView
                            android:id="@+id/tagElectronic"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="电子"
                            android:textColor="@color/shop_text_muted"
                            android:textSize="13sp"
                            android:background="@drawable/create_tag_normal"
                            android:paddingHorizontal="14dp"
                            android:paddingVertical="7dp"
                            android:layout_marginEnd="8dp"
                            android:clickable="true"
                            android:focusable="true" />

                        <TextView
                            android:id="@+id/tagFusion"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="融合"
                            android:textColor="@color/shop_text_muted"
                            android:textSize="13sp"
                            android:background="@drawable/create_tag_normal"
                            android:paddingHorizontal="14dp"
                            android:paddingVertical="7dp"
                            android:layout_marginEnd="8dp"
                            android:clickable="true"
                            android:focusable="true" />

                        <TextView
                            android:id="@+id/tagInstrumental"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="器乐"
                            android:textColor="@color/shop_text_muted"
                            android:textSize="13sp"
                            android:background="@drawable/create_tag_normal"
                            android:paddingHorizontal="14dp"
                            android:paddingVertical="7dp"
                            android:layout_marginEnd="8dp"
                            android:clickable="true"
                            android:focusable="true" />

                        <TextView
                            android:id="@+id/tagVocal"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="声乐"
                            android:textColor="@color/shop_text_muted"
                            android:textSize="13sp"
                            android:background="@drawable/create_tag_normal"
                            android:paddingHorizontal="14dp"
                            android:paddingVertical="7dp"
                            android:layout_marginEnd="8dp"
                            android:clickable="true"
                            android:focusable="true" />

                        <TextView
                            android:id="@+id/tagRemix"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="改编"
                            android:textColor="@color/shop_text_muted"
                            android:textSize="13sp"
                            android:background="@drawable/create_tag_normal"
                            android:paddingHorizontal="14dp"
                            android:paddingVertical="7dp"
                            android:clickable="true"
                            android:focusable="true" />

                    </LinearLayout>

                </HorizontalScrollView>

            </LinearLayout>

        </androidx.cardview.widget.CardView>

    </LinearLayout>

</ScrollView>
