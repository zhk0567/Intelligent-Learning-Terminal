<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    app:cardBackgroundColor="@color/bg_card"
    app:cardCornerRadius="12dp"
    app:cardElevation="2dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

    <!-- 订单号 -->
    <TextView
        android:id="@+id/orderNumberTextView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="订单号:202404220001"
        android:textColor="@color/text_primary"
        android:textSize="16sp"
        android:textStyle="bold" />

    <!-- 订单时间 -->
    <TextView
        android:id="@+id/orderTimeTextView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="下单时间:2024-04-22 10:30:00"
        android:textColor="@color/text_secondary"
        android:textSize="14sp" />

    <!-- 订单状态 -->
    <TextView
        android:id="@+id/statusTextView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="待支付"
        android:textSize="14sp"
        android:textStyle="bold"
        android:layout_gravity="end" />

    <!-- 商品列表容器 -->
    <LinearLayout
        android:id="@+id/productContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:orientation="vertical" />

    <!-- 收货信息 -->
    <TextView
        android:id="@+id/receiverInfoTextView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="张三 13800138000"
        android:textColor="@color/text_primary"
        android:textSize="14sp" />

    <!-- 收货地址 -->
    <TextView
        android:id="@+id/shippingAddressTextView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="北京市朝阳区建国路88号"
        android:textColor="@color/text_secondary"
        android:textSize="14sp" />

    <!-- 订单金额 -->
    <TextView
        android:id="@+id/totalAmountTextView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="¥3998.00"
        android:textColor="@color/text_primary"
        android:textSize="18sp"
        android:textStyle="bold"
        android:layout_gravity="end" />

    <!-- 操作按钮：等分宽度，单行排布，无需横向滑动 -->
    <LinearLayout
        android:id="@+id/actionButtonContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:baselineAligned="false"
        android:gravity="center_vertical"
        android:orientation="horizontal" />

    </LinearLayout>

</androidx.cardview.widget.CardView>
