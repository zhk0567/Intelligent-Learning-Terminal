<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    app:cardBackgroundColor="@color/bg_card"
    app:cardCornerRadius="12dp"
    app:cardElevation="2dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="12dp"
        android:gravity="center_vertical">

        <!-- 缩略图 -->
        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/historyItemImage"
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:scaleType="centerCrop"
            android:background="@color/bg_card"
            app:shapeAppearanceOverlay="@style/ShapeImageRounded12" />

        <!-- 信息区域 -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginStart="12dp">

            <!-- 标题 -->
            <TextView
                android:id="@+id/historyItemTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="标题"
                android:textColor="@color/text_primary"
                android:textSize="15sp"
                android:maxLines="2"
                android:ellipsize="end" />

            <!-- 类型标签 -->
            <TextView
                android:id="@+id/historyItemType"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="商品"
                android:textColor="@color/tech_blue"
                android:textSize="12sp"
                android:background="@drawable/tag_bg_normal"
                android:paddingHorizontal="8dp"
                android:paddingVertical="3dp"
                android:layout_marginTop="6dp" />

            <!-- 浏览时间 -->
            <TextView
                android:id="@+id/historyItemTime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="2024-01-15 14:30"
                android:textColor="@color/text_hint"
                android:textSize="12sp"
                android:layout_marginTop="6dp" />

        </LinearLayout>

        <!-- 删除按钮 -->
        <ImageView
            android:id="@+id/deleteButton"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:src="@android:drawable/ic_menu_delete"
            android:tint="@color/text_secondary"
            android:padding="6dp"
            android:clickable="true"
            android:focusable="true"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="删除" />

    </LinearLayout>

</androidx.cardview.widget.CardView>
