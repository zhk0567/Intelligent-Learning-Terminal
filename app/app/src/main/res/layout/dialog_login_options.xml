<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="320dp"
    android:background="@color/shop_chip_bg">

    <!-- 顶部淡金边框 -->
    <View
        android:id="@+id/topBorder"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/gold_accent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- 弹窗标题 -->
    <TextView
        android:id="@+id/dialogTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="选择登录方式"
        android:textColor="@color/shop_cream_text"
        android:textSize="18sp"
        android:textStyle="bold"
        android:fontFamily="sans-serif-medium"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/topBorder" />

    <!-- 选项1：手机号登录 -->
    <LinearLayout
        android:id="@+id/optionPhone"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginTop="24dp"
        android:background="?attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        app:layout_constraintTop_toBottomOf="@id/dialogTitle">

        <!-- 手机图标 -->
        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ic_phone_outline"
            android:contentDescription="手机图标"
            app:tint="@color/shop_stone_blue" />

        <!-- 选项文字 -->
        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_weight="1"
            android:text="手机号登录"
            android:textColor="@color/shop_cream_text"
            android:textSize="16sp"
            android:fontFamily="sans-serif" />

        <!-- 推荐标签 -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="16dp"
            android:background="@color/gold_accent"
            android:paddingStart="4dp"
            android:paddingTop="2dp"
            android:paddingEnd="4dp"
            android:paddingBottom="2dp"
            android:text="推荐"
            android:textColor="@color/text_ink_on_gold"
            android:textSize="10sp"
            android:textStyle="bold"
            android:fontFamily="sans-serif-medium" />

        <!-- 右箭头 -->
        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="@drawable/ic_arrow_right"
            android:contentDescription="箭头"
            app:tint="@color/shop_text_muted" />

    </LinearLayout>

    <!-- 分隔线1 -->
    <View
        android:id="@+id/divider1"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/shop_chip_border"
        app:layout_constraintTop_toBottomOf="@id/optionPhone" />

    <!-- 选项2：账号密码登录 -->
    <LinearLayout
        android:id="@+id/optionPassword"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="?attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        app:layout_constraintTop_toBottomOf="@id/divider1">

        <!-- 钥匙图标 -->
        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ic_key_outline"
            android:contentDescription="钥匙图标"
            app:tint="@color/shop_indigo" />

        <!-- 选项文字 -->
        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_weight="1"
            android:text="账号密码登录"
            android:textColor="@color/shop_cream_text"
            android:textSize="16sp"
            android:fontFamily="sans-serif" />

        <!-- 右箭头 -->
        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="@drawable/ic_arrow_right"
            android:contentDescription="箭头"
            app:tint="@color/shop_text_muted" />

    </LinearLayout>

    <!-- 分隔线2 -->
    <View
        android:id="@+id/divider2"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/shop_chip_border"
        app:layout_constraintTop_toBottomOf="@id/optionPassword" />

    <!-- 选项3：游客模式 -->
    <LinearLayout
        android:id="@+id/optionGuest"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="?attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        app:layout_constraintTop_toBottomOf="@id/divider2">

        <!-- 访客图标 -->
        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ic_guest_outline"
            android:contentDescription="访客图标"
            app:tint="@color/shop_text_muted" />

        <!-- 选项文字 -->
        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_weight="1"
            android:text="游客模式体验"
            android:textColor="@color/shop_cream_text"
            android:textSize="16sp"
            android:fontFamily="sans-serif" />

        <!-- 右箭头 -->
        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="@drawable/ic_arrow_right"
            android:contentDescription="箭头"
            app:tint="@color/shop_text_muted" />

    </LinearLayout>

    <!-- 底部提示文字 -->
    <TextView
        android:id="@+id/bottomHint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="24dp"
        android:layout_marginTop="16dp"
        android:layout_marginEnd="24dp"
        android:layout_marginBottom="24dp"
        android:gravity="center"
        android:text="游客模式可浏览部分内容，登录解锁完整功能"
        android:textColor="@color/shop_text_muted"
        android:textSize="12sp"
        android:fontFamily="sans-serif"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@id/optionGuest" />

</androidx.constraintlayout.widget.ConstraintLayout>
