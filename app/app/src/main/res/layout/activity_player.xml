<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/player_screen_background"
    android:fitsSystemWindows="true"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="16dp"
        android:paddingEnd="20dp"
        android:paddingBottom="28dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/backButton"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/cd_back"
                android:padding="12dp"
                android:src="@drawable/ic_back"
                app:tint="@color/player_control_tint" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:text="正在播放"
                android:textColor="@color/text_secondary"
                android:textSize="14sp"
                android:fontFamily="sans-serif-medium" />

            <ImageButton
                android:id="@+id/playlistButton"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:contentDescription="播放列表"
                android:padding="12dp"
                android:src="@drawable/ic_mini_list"
                app:tint="@color/player_control_tint" />
        </LinearLayout>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:layout_marginBottom="12dp"
            android:foregroundGravity="center_horizontal">

            <FrameLayout
                android:layout_width="280dp"
                android:layout_height="280dp"
                android:layout_gravity="center_horizontal"
                android:background="@drawable/player_cover_frame"
                android:padding="6dp">

                <com.google.android.material.imageview.ShapeableImageView
                    android:id="@+id/coverImageView"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop"
                    android:src="@drawable/music_cover_placeholder"
                    app:shapeAppearanceOverlay="@style/ShapeImageRounded18" />
            </FrameLayout>
        </FrameLayout>

        <TextView
            android:id="@+id/musicTitleTextView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:ellipsize="end"
            android:gravity="center"
            android:lineSpacingMultiplier="1.3"
            android:maxLines="2"
            android:textColor="@color/text_primary"
            android:textSize="22sp"
            android:textStyle="bold" />

        <View
            android:layout_width="160dp"
            android:layout_height="2dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="10dp"
            android:background="@color/ancient_gold"
            android:alpha="0.85" />

        <TextView
            android:id="@+id/artistTextView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:ellipsize="end"
            android:gravity="center"
            android:lineSpacingMultiplier="1.3"
            android:maxLines="1"
            android:textColor="@color/text_secondary"
            android:textSize="15sp"
            android:fontFamily="sans-serif-medium" />

        <TextView
            android:id="@+id/albumTextView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="10dp"
            android:background="@drawable/player_album_chip_bg"
            android:paddingHorizontal="14dp"
            android:paddingVertical="6dp"
            android:textColor="@color/ancient_gold"
            android:textSize="13sp"
            android:fontFamily="sans-serif-medium" />

        <SeekBar
            android:id="@+id/seekBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:maxHeight="6dp"
            android:minHeight="6dp"
            android:paddingHorizontal="4dp"
            android:progressDrawable="@drawable/player_seekbar_progress_ancient"
            android:thumb="@drawable/player_seekbar_thumb_ancient"
            android:thumbOffset="0dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:orientation="horizontal"
            android:paddingHorizontal="4dp">

            <TextView
                android:id="@+id/currentTimeTextView"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="00:00"
                android:textColor="@color/text_secondary"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/totalTimeTextView"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="end"
                android:text="00:00"
                android:textColor="@color/text_secondary"
                android:textSize="13sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/playbackControls"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/shufflePlayButton"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:contentDescription="随机播放"
                android:padding="12dp"
                android:src="@drawable/ic_shuffle"
                app:tint="@color/player_control_tint" />

            <Space
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <ImageButton
                android:id="@+id/previousButton"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:contentDescription="上一首"
                android:padding="12dp"
                android:src="@drawable/ic_mini_prev"
                app:tint="@color/player_control_tint" />

            <ImageButton
                android:id="@+id/playPauseButton"
                android:layout_width="76dp"
                android:layout_height="76dp"
                android:layout_marginHorizontal="20dp"
                android:background="@drawable/player_main_play_button_ancient"
                android:contentDescription="播放暂停"
                android:padding="16dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_player_main_play"
                app:tint="@color/white" />

            <ImageButton
                android:id="@+id/nextButton"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:contentDescription="下一首"
                android:padding="12dp"
                android:src="@drawable/ic_mini_next"
                app:tint="@color/player_control_tint" />

            <Space
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <ImageButton
                android:id="@+id/sequentialPlayButton"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:contentDescription="循环模式"
                android:padding="12dp"
                android:src="@drawable/ic_repeat"
                app:tint="@color/player_control_tint" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:gravity="center"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/favoriteButton"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:contentDescription="收藏"
                android:padding="12dp"
                android:src="@drawable/ic_favorite_border"
                app:tint="@color/player_control_tint" />

            <ImageButton
                android:id="@+id/downloadButton"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:contentDescription="下载"
                android:padding="12dp"
                android:src="@drawable/ic_download"
                app:tint="@color/player_control_tint" />

            <ImageButton
                android:id="@+id/shareButton"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:contentDescription="分享"
                android:padding="12dp"
                android:src="@drawable/ic_share"
                app:tint="@color/player_control_tint" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
