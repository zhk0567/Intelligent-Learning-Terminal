<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/drawer_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- 主内容区：fitsSystemWindows 放在这里，背景会延伸到状态栏下方 -->
    <LinearLayout
        android:id="@+id/profile_main_host"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:background="@color/bg_primary"
        android:fitsSystemWindows="false">

        <!-- 可滚动内容区 -->
        <ScrollView
            android:id="@+id/profile_scroll"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:overScrollMode="never"
            android:fillViewport="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- 顶部用户信息区 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp"
                    android:background="@android:color/transparent">

                    <!-- 标题和菜单按钮 -->
                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="20dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:text="我的"
                            android:textColor="@color/text_primary"
                            android:textSize="24sp"
                            android:textStyle="bold" />
                    </FrameLayout>

                    <!-- 头像和用户信息卡片 -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:background="@drawable/profile_card_gradient_bg"
                        android:padding="20dp">

                        <!-- 头像容器：添加光环效果 -->
                        <FrameLayout
                            android:layout_width="82dp"
                            android:layout_height="82dp">
                            
                            <!-- 霓虹光环层 -->
                            <ImageView
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:src="@drawable/profile_avatar_bg"
                                android:contentDescription="头像光环"/>
                            
                            <!-- 头像本体：使用 CardView 实现圆形裁剪 -->
                            <androidx.cardview.widget.CardView
                                android:layout_width="74dp"
                                android:layout_height="74dp"
                                android:layout_gravity="center"
                                app:cardCornerRadius="37dp"
                                app:cardElevation="0dp">
                                
                                <ImageView
                                    android:id="@+id/profile_avatar"
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"
                                    android:src="@drawable/banner1_img"
                                    android:scaleType="centerCrop"
                                    android:contentDescription="用户头像"/>
                            </androidx.cardview.widget.CardView>
                        </FrameLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:layout_marginStart="16dp">

                            <TextView
                                android:id="@+id/profile_username"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="非遗文化爱好者"
                                android:textSize="18sp"
                                android:textColor="@color/text_primary"
                                android:textStyle="bold"/>

                            <TextView
                                android:id="@+id/profile_bio"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="已关注4 | 粉丝12"
                                android:textSize="13sp"
                                android:textColor="@color/text_secondary"
                                android:layout_marginTop="6dp"/>
                                
                            <!-- VIP标签：金色渐变 -->
                            <TextView
                                android:id="@+id/profile_vip_badge"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="VIP会员"
                                android:textSize="11sp"
                                android:textColor="@color/text_primary"
                                android:textStyle="bold"
                                android:background="@drawable/vip_golden_gradient"
                                android:paddingHorizontal="12dp"
                                android:paddingVertical="4dp"
                                android:layout_marginTop="8dp" />
                        </LinearLayout>
                    </LinearLayout>

                    <!-- 统计卡片（外框与常用功能一致） -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:background="@drawable/home_section_outline_bg"
                        android:padding="12dp"
                        android:layout_marginTop="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="96dp"
                            android:layout_weight="1"
                            android:background="@drawable/stat_card_bg"
                            android:orientation="vertical"
                            android:gravity="center"
                            android:layout_marginEnd="6dp">
                            <ImageView
                                android:layout_width="32dp"
                                android:layout_height="32dp"
                                android:src="@drawable/ic_menu_favorite"
                                app:tint="@color/neon_teal"
                                android:contentDescription="收藏"/>
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="收藏"
                                android:textSize="13sp"
                                android:textColor="@color/text_secondary"
                                android:layout_marginTop="10dp"/>
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="96dp"
                            android:layout_weight="1"
                            android:background="@drawable/stat_card_bg"
                            android:orientation="vertical"
                            android:gravity="center"
                            android:layout_marginHorizontal="3dp">
                            <ImageView
                                android:layout_width="32dp"
                                android:layout_height="32dp"
                                android:src="@drawable/ic_menu_footprint"
                                app:tint="@color/neon_teal"
                                android:contentDescription="足迹"/>
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="足迹"
                                android:textSize="13sp"
                                android:textColor="@color/text_secondary"
                                android:layout_marginTop="10dp"/>
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="96dp"
                            android:layout_weight="1"
                            android:background="@drawable/stat_card_bg"
                            android:orientation="vertical"
                            android:gravity="center"
                            android:layout_marginStart="6dp">
                            <ImageView
                                android:layout_width="32dp"
                                android:layout_height="32dp"
                                android:src="@drawable/ic_menu_works"
                                app:tint="@color/neon_teal"
                                android:contentDescription="创作"/>
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="创作"
                                android:textSize="13sp"
                                android:textColor="@color/text_secondary"
                                android:layout_marginTop="10dp"/>
                        </LinearLayout>
                    </LinearLayout>
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:background="@drawable/home_section_outline_bg"
                        android:padding="12dp"
                        android:layout_marginTop="16dp">

                    <!-- 功能菜单 -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="常用功能"
                        android:textColor="@color/text_primary"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:layout_marginTop="0dp"
                        android:layout_marginBottom="8dp" />

                    <!-- 菜单列表 -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <!-- 我的收藏 -->
                        <LinearLayout
                            android:id="@+id/learn1"
                            android:layout_width="match_parent"
                            android:layout_height="60dp"
                            android:background="@drawable/menu_item_ripple_bg"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:paddingHorizontal="18dp"
                            android:clickable="true"
                            android:focusable="true">
                            <ImageView
                                android:layout_width="24dp"
                                android:layout_height="24dp"
                                android:src="@drawable/ic_menu_favorite"
                                android:contentDescription="我的收藏"/>
                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="我的收藏"
                                android:textSize="15sp"
                                android:textColor="@color/text_primary"
                                android:layout_marginStart="16dp"/>
                            <ImageView
                                android:layout_width="18dp"
                                android:layout_height="18dp"
                                android:src="@drawable/ic_forward"
                                app:tint="@color/text_hint"
                                android:contentDescription="进入"/>
                        </LinearLayout>

                        <!-- 我的购买 -->
                        <LinearLayout
                            android:id="@+id/learn2"
                            android:layout_width="match_parent"
                            android:layout_height="60dp"
                            android:background="@drawable/menu_item_ripple_bg"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:paddingHorizontal="18dp"
                            android:layout_marginTop="8dp"
                            android:clickable="true"
                            android:focusable="true">
                            <ImageView
                                android:layout_width="24dp"
                                android:layout_height="24dp"
                                android:src="@drawable/ic_menu_cart"
                                android:contentDescription="我的购买"/>
                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="我的购买"
                                android:textSize="15sp"
                                android:textColor="@color/text_primary"
                                android:layout_marginStart="16dp"/>
                            <ImageView
                                android:layout_width="18dp"
                                android:layout_height="18dp"
                                android:src="@drawable/ic_forward"
                                app:tint="@color/text_hint"
                                android:contentDescription="进入"/>
                        </LinearLayout>

                        <!-- 浏览历史 -->
                        <LinearLayout
                            android:id="@+id/learn4"
                            android:layout_width="match_parent"
                            android:layout_height="60dp"
                            android:background="@drawable/menu_item_ripple_bg"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:paddingHorizontal="18dp"
                            android:layout_marginTop="8dp"
                            android:clickable="true"
                            android:focusable="true">
                            <ImageView
                                android:layout_width="24dp"
                                android:layout_height="24dp"
                                android:src="@drawable/ic_menu_history"
                                android:contentDescription="浏览历史"/>
                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="浏览历史"
                                android:textSize="15sp"
                                android:textColor="@color/text_primary"
                                android:layout_marginStart="16dp"/>
                            <ImageView
                                android:layout_width="18dp"
                                android:layout_height="18dp"
                                android:src="@drawable/ic_forward"
                                app:tint="@color/text_hint"
                                android:contentDescription="进入"/>
                        </LinearLayout>

                        <!-- 我的作品 -->
                        <LinearLayout
                            android:id="@+id/learn5"
                            android:layout_width="match_parent"
                            android:layout_height="60dp"
                            android:background="@drawable/menu_item_ripple_bg"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:paddingHorizontal="18dp"
                            android:layout_marginTop="8dp"
                            android:clickable="true"
                            android:focusable="true">
                            <ImageView
                                android:layout_width="24dp"
                                android:layout_height="24dp"
                                android:src="@drawable/ic_menu_works"
                                android:contentDescription="我的作品"/>
                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="我的作品"
                                android:textSize="15sp"
                                android:textColor="@color/text_primary"
                                android:layout_marginStart="16dp"/>
                            <ImageView
                                android:layout_width="18dp"
                                android:layout_height="18dp"
                                android:src="@drawable/ic_forward"
                                app:tint="@color/text_hint"
                                android:contentDescription="进入"/>
                        </LinearLayout>

                        <!-- 我的学习 -->
                        <LinearLayout
                            android:id="@+id/learn6"
                            android:layout_width="match_parent"
                            android:layout_height="60dp"
                            android:background="@drawable/menu_item_ripple_bg"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:paddingHorizontal="18dp"
                            android:layout_marginTop="8dp"
                            android:clickable="true"
                            android:focusable="true">
                            <ImageView
                                android:layout_width="24dp"
                                android:layout_height="24dp"
                                android:src="@drawable/ic_menu_learning"
                                android:contentDescription="我的学习"/>
                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="我的学习"
                                android:textSize="15sp"
                                android:textColor="@color/text_primary"
                                android:layout_marginStart="16dp"/>
                            <ImageView
                                android:layout_width="18dp"
                                android:layout_height="18dp"
                                android:src="@drawable/ic_forward"
                                app:tint="@color/text_hint"
                                android:contentDescription="进入"/>
                        </LinearLayout>

                        <!-- 设置 -->
                        <LinearLayout
                            android:id="@+id/learn3"
                            android:layout_width="match_parent"
                            android:layout_height="60dp"
                            android:background="@drawable/menu_item_ripple_bg"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:paddingHorizontal="18dp"
                            android:layout_marginTop="8dp"
                            android:clickable="true"
                            android:focusable="true">
                            <ImageView
                                android:layout_width="24dp"
                                android:layout_height="24dp"
                                android:src="@drawable/ic_menu_settings"
                                android:contentDescription="设置"/>
                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="设置"
                                android:textSize="15sp"
                                android:textColor="@color/text_primary"
                                android:layout_marginStart="16dp"/>
                            <ImageView
                                android:layout_width="18dp"
                                android:layout_height="18dp"
                                android:src="@drawable/ic_forward"
                                app:tint="@color/text_hint"
                                android:contentDescription="进入"/>
                        </LinearLayout>
                    </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </ScrollView>

        <!-- 底部导航 -->
        <include layout="@layout/bottom_navigation"/>

    </LinearLayout>

    <!-- 侧边栏 -->
    <include layout="@layout/layout_profile_drawer"/>

</androidx.drawerlayout.widget.DrawerLayout>
