<?xml version="1.0" encoding="utf-8"?>
<!-- 
    Ancient Tech Card with Neon Border Effect
    Enhanced card background with neon cyan border and subtle glow
    Used for highlighted or interactive cards
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    
    <!-- Vertical gradient background -->
    <gradient
        android:startColor="@color/card_gradient_start"
        android:endColor="@color/card_gradient_end"
        android:angle="270" />
    
    <!-- Rounded corners -->
    <corners android:radius="@dimen/card_corner_radius_large" />
    
    <!-- Thick neon cyan border with glow effect -->
    <stroke
        android:width="@dimen/card_border_width_medium"
        android:color="@color/tech_blue" />
    
    <!-- Inner padding to create space between border and content -->
    <padding
        android:left="@dimen/card_padding_internal"
        android:top="@dimen/card_padding_internal"
        android:right="@dimen/card_padding_internal"
        android:bottom="@dimen/card_padding_internal" />
    
</shape>