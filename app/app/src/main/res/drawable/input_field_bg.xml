<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- 聚焦状态 -->
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/shop_chip_bg" />
            <corners android:radius="12dp" />
            <stroke
                android:width="1dp"
                android:color="@color/shop_stone_blue" />
        </shape>
    </item>
    
    <!-- 默认状态 -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/shop_chip_bg" />
            <corners android:radius="12dp" />
            <stroke
                android:width="1dp"
                android:color="@color/shop_chip_border" />
        </shape>
    </item>
</selector>
