<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- 顶部压暗，保证返回键区域可读 -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:centerColor="@android:color/transparent"
                android:endColor="@android:color/transparent"
                android:startColor="@color/story_hero_scrim_top"
                android:type="linear" />
        </shape>
    </item>
    <!-- 底部与正文卡片同色，消除头图与内容割裂 -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="90"
                android:centerColor="@color/story_hero_blend_mid"
                android:endColor="@color/story_hero_blend_end"
                android:startColor="@android:color/transparent"
                android:type="linear" />
        </shape>
    </item>
</layer-list>
