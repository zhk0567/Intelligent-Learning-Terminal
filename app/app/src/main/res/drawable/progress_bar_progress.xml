<?xml version="1.0" encoding="utf-8"?>
<!-- 
    Ancient Tech Progress Bar Progress
    Progress fill for progress bars with gradient Ancient Tech styling
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    
    <!-- Gradient progress fill -->
    <gradient
        android:startColor="@color/neon_cyan"
        android:endColor="@color/tech_blue"
        android:angle="0" />
    
    <!-- Rounded corners -->
    <corners android:radius="@dimen/button_corner_radius_round" />
    
</shape>