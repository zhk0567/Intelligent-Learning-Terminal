<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="135"
                android:endColor="@color/shop_zone_grad_end"
                android:startColor="@color/shop_zone_grad_start" />
            <corners android:radius="14dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <stroke
                android:width="1dp"
                android:color="@color/shop_zone_border_gold" />
            <corners android:radius="14dp" />
            <solid android:color="@android:color/transparent" />
        </shape>
    </item>
</layer-list>
