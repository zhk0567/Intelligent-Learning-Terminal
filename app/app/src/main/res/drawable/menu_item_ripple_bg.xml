<?xml version="1.0" encoding="utf-8"?>
<!-- 功能菜单项背景:带点击涟漪效果 -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="@color/ripple_primary_mask">
    <item>
        <layer-list>
            <!-- 阴影层 -->
            <item android:top="1dp">
                <shape android:shape="rectangle">
                    <solid android:color="@color/press_overlay_shadow"/>
                    <corners android:radius="12dp"/>
                </shape>
            </item>
            <!-- 主背景层 -->
            <item>
                <shape android:shape="rectangle">
                    <gradient
                        android:startColor="@color/bg_card"
                        android:endColor="@color/card_gradient_end"
                        android:angle="0"/>
                    <corners android:radius="12dp"/>
                    <stroke
                        android:width="0.5dp"
                        android:color="@color/neon_cyan_glow"/>
                </shape>
            </item>
        </layer-list>
    </item>
</ripple>
