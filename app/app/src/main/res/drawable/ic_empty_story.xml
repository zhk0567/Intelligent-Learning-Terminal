<?xml version="1.0" encoding="utf-8"?>
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="120dp"
    android:height="120dp"
    android:viewportWidth="120"
    android:viewportHeight="120">
    <!-- Book outline -->
    <path
        android:strokeColor="@color/text_secondary"
        android:strokeWidth="3"
        android:pathData="M30,30 L90,30 L90,90 L30,90 Z"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:fillColor="@android:color/transparent" />
    
    <!-- Book spine -->
    <path
        android:strokeColor="@color/text_secondary"
        android:strokeWidth="2"
        android:pathData="M30,30 L30,90"
        android:strokeLineCap="round"
        android:fillColor="@android:color/transparent" />
    
    <!-- Pages -->
    <path
        android:strokeColor="@color/text_hint"
        android:strokeWidth="1"
        android:pathData="M35,40 L85,40 M35,50 L85,50 M35,60 L85,60 M35,70 L85,70 M35,80 L85,80"
        android:strokeLineCap="round"
        android:fillColor="@android:color/transparent" />
    
    <!-- Pen -->
    <path
        android:strokeColor="@color/tech_blue"
        android:strokeWidth="2"
        android:pathData="M100,20 L80,40"
        android:strokeLineCap="round"
        android:fillColor="@android:color/transparent" />
</vector>