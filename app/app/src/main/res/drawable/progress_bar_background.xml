<?xml version="1.0" encoding="utf-8"?>
<!-- 
    Ancient Tech Progress Bar Background
    Background track for progress bars with Ancient Tech styling
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    
    <!-- Dark background for track -->
    <solid android:color="@color/bg_card" />
    
    <!-- Rounded corners -->
    <corners android:radius="@dimen/button_corner_radius_round" />
    
    <!-- Subtle border -->
    <stroke
        android:width="@dimen/button_border_width_thin"
        android:color="@color/divider_light" />
    
</shape>