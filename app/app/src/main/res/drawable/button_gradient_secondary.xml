<?xml version="1.0" encoding="utf-8"?>
<!-- 
    Ancient Tech Secondary Button Gradient
    Gradient from jade to tech blue with subtle border
    Used for secondary action buttons
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    
    <!-- Vertical gradient from jade to tech blue -->
    <gradient
        android:startColor="@color/jade"
        android:endColor="@color/tech_blue"
        android:angle="270" />
    
    <!-- Rounded corners -->
    <corners android:radius="@dimen/button_corner_radius_large" />
    
    <!-- Subtle border -->
    <stroke
        android:width="@dimen/button_border_width_thin"
        android:color="@color/divider_light" />
    
    <!-- Inner padding for button content -->
    <padding
        android:left="@dimen/button_padding_horizontal_medium"
        android:top="@dimen/button_padding_vertical_medium"
        android:right="@dimen/button_padding_horizontal_medium"
        android:bottom="@dimen/button_padding_vertical_medium" />
    
</shape>