<?xml version="1.0" encoding="utf-8"?>
<!-- 统计卡片背景:带微妙渐变和边框 -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- 阴影层 -->
    <item android:top="2dp" android:left="2dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/overlay_black_06"/>
            <corners android:radius="14dp"/>
        </shape>
    </item>
    <!-- 主背景层 -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:startColor="@color/bg_card"
                android:endColor="@color/shop_sales_pill_bg"
                android:angle="135"/>
            <corners android:radius="14dp"/>
            <stroke
                android:width="1dp"
                android:color="@color/neon_cyan_border_ultrasoft"/>
        </shape>
    </item>
</layer-list>
