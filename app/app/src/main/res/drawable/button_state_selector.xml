<?xml version="1.0" encoding="utf-8"?>
<!-- 
    Ancient Tech Button State Selector
    Provides different backgrounds for normal, pressed, and disabled states
    Used for interactive buttons with visual feedback
-->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    
    <!-- Disabled state - grayed out with no border -->
    <item android:state_enabled="false">
        <shape android:shape="rectangle">
            <solid android:color="@color/bg_card" />
            <corners android:radius="@dimen/button_corner_radius_round" />
            <stroke
                android:width="@dimen/button_border_width_thin"
                android:color="@color/text_hint" />
        </shape>
    </item>
    
    <!-- Pressed state - darker gradient with brighter border -->
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <gradient
                android:startColor="@color/ancient_red"
                android:endColor="@color/purple"
                android:angle="45" />
            <corners android:radius="@dimen/button_corner_radius_round" />
            <stroke
                android:width="@dimen/button_border_width_medium"
                android:color="@color/tech_blue" />
        </shape>
    </item>
    
    <!-- Normal state - default gradient with neon border -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:startColor="@color/ancient_gold"
                android:endColor="@color/ancient_red"
                android:angle="45" />
            <corners android:radius="@dimen/button_corner_radius_round" />
            <stroke
                android:width="@dimen/button_border_width_medium"
                android:color="@color/tech_blue" />
        </shape>
    </item>
    
</selector>